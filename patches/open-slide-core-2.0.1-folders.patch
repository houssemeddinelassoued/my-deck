+function PresenterSplitter({
+  orientation,
+  label,
+  value,
+  min,
+  max,
+  className,
+  onResizeStart,
+  onResize,
+  onStep,
+  onReset,
+}: {
+  // `vertical` is a column divider (drag left/right); `horizontal` a row divider.
+  orientation: 'vertical' | 'horizontal';
+  label: string;
+  // null while the pane is auto-sized.
+  value: number | null;
+  min: number;
+  max: number;
+  className?: string;
+  onResizeStart: () => void;
+  onResize: (deltaPx: number) => void;
+  onStep: (deltaPct: number) => void;
+  onReset: () => void;
+}) {
+  const t = useLocale();
+  const vertical = orientation === 'vertical';
+  const [resizing, setResizing] = useState(false);
+  const startRef = useRef<number | null>(null);
+
+  useEffect(() => {
+    if (!resizing) return;
+    const prev = {
+      cursor: document.body.style.cursor,
+      userSelect: document.body.style.userSelect,
+    };
+    document.body.style.cursor = vertical ? 'col-resize' : 'row-resize';
+    document.body.style.userSelect = 'none';
+    return () => {
+      document.body.style.cursor = prev.cursor;
+      document.body.style.userSelect = prev.userSelect;
+    };
+  }, [resizing, vertical]);
+
+  const onPointerDown = (e: React.PointerEvent<HTMLDivElement>) => {
+    e.preventDefault();
+    e.currentTarget.setPointerCapture(e.pointerId);
+    startRef.current = vertical ? e.clientX : e.clientY;
+    onResizeStart();
+    setResizing(true);
+  };
+
+  const onPointerMove = (e: React.PointerEvent<HTMLDivElement>) => {
+    if (startRef.current === null) return;
+    onResize((vertical ? e.clientX : e.clientY) - startRef.current);
+  };
+
+  const onPointerUp = (e: React.PointerEvent<HTMLDivElement>) => {
+    if (e.currentTarget.hasPointerCapture(e.pointerId)) {
+      e.currentTarget.releasePointerCapture(e.pointerId);
+    }
+    startRef.current = null;
+    setResizing(false);
+  };
+
+  // Arrow keys would otherwise drive the deck (window listener skips
+  // default-prevented events).
+  const onKeyDown = (e: React.KeyboardEvent<HTMLDivElement>) => {
+    const step = e.shiftKey ? 10 : 2;
+    const back = vertical ? 'ArrowLeft' : 'ArrowUp';
+    const forward = vertical ? 'ArrowRight' : 'ArrowDown';
+    if (e.key === back || e.key === forward) {
+      e.preventDefault();
+      e.stopPropagation();
+      onStep(e.key === back ? -step : step);
+    } else if (e.key === 'Home') {
+      e.preventDefault();
+      e.stopPropagation();
+      onReset();
+    }
+  };
+
+  return (
+    // biome-ignore lint/a11y/useSemanticElements: focusable resize handle (splitter pattern), not a static <hr>
+    <div
+      role="separator"
+      aria-orientation={orientation}
+      aria-label={label}
+      aria-valuenow={value === null ? undefined : Math.round(value)}
+      aria-valuemin={min}
+      aria-valuemax={max}
+      title={t.presenter.resizeHint}
+      tabIndex={0}
+      onPointerDown={onPointerDown}
+      onPointerMove={onPointerMove}
+      onPointerUp={onPointerUp}
+      onPointerCancel={onPointerUp}
+      onKeyDown={onKeyDown}
+      onDoubleClick={onReset}
+      className={cn(
+        'group/resize relative shrink-0 touch-none rounded-[3px] outline-none',
+        vertical ? 'cursor-col-resize' : 'cursor-row-resize',
+        'focus-visible:bg-brand/10',
+        className,
+      )}
+    >
+      <span
+        aria-hidden
+        className={cn(
+          'pointer-events-none absolute rounded-full bg-border transition-[background-color,opacity] duration-150',
+          vertical
+            ? 'inset-y-[30%] left-1/2 w-[3px] -translate-x-1/2'
+            : 'inset-x-[30%] top-1/2 h-[3px] -translate-y-1/2',
+          'opacity-60 group-hover/resize:bg-brand group-hover/resize:opacity-100 group-focus-visible/resize:bg-brand group-focus-visible/resize:opacity-100',
+          resizing && 'bg-brand opacity-100',
+        )}
       />
     </div>
   );
