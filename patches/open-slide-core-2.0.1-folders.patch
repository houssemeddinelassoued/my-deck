+    const sync = () => setOverrides(readTimerOverrides(slideId));
+    window.addEventListener(TIMER_OVERRIDES_EVENT, sync);
+    window.addEventListener('storage', sync);
+    return () => {
+      window.removeEventListener(TIMER_OVERRIDES_EVENT, sync);
+      window.removeEventListener('storage', sync);
+    };
+  }, [slideId]);
+
+  useEffect(() => {
+    setCheckedAt(Date.now());
+  }, [index, config]);
+
+  const openForm = () => {
+    const start = config?.start ?? suggestedStart(plan, day);
+    setDraftStart(toDateTimeInput(start));
+    setDraftEnd(config?.end ? toTimeInput(config.end) : '');
+    setDraftTol(String(config?.tolerance ?? DEFAULT_TOLERANCE_MIN));
+    setEditing(true);
+  };
+
+  // Re-times the deck's timers of the rest of the day to the real time left
+  // (until the end given, else until the planned end of the day).
+  const recalibrate = (cfg: DayConfig | null = config) => {
+    if (!cfg || !timers || timers.length === 0) return;
+    const endAt = cfg.end ?? cfg.start + (dayPlan?.span ?? 0) * 60000;
+    const res = recalibrateTimers({ timers, plan, index, endAt, now: Date.now(), overrides });
