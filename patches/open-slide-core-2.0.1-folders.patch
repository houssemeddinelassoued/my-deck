diff --git b/src/app/components/present/start-punctuality.tsx b/src/app/components/present/start-punctuality.tsx
new file mode 100644
--- /dev/null
+++ b/src/app/components/present/start-punctuality.tsx
@@ -0,0 +1,132 @@
+import { Check, Pencil } from 'lucide-react';
+import { useEffect, useState } from 'react';
+
+// Planned start of a training (date + time) is typed once per deck, then every
+// slide change compares "now" with it and shows early / on time / late. A gap
+// of up to TOLERANCE_MIN either way counts as "synchrone".
+const TOLERANCE_MIN = 15;
+const storageKey = (slideId: string) => `osd-planned-start:${slideId}`;
+
+function readPlanned(slideId: string): number | null {
+  try {
+    const n = Number(window.localStorage.getItem(storageKey(slideId)));
+    return Number.isFinite(n) && n > 0 ? n : null;
+  } catch {
+    return null;
+  }
+}
+
+const pad = (n: number) => String(n).padStart(2, '0');
+
+function toInputValue(ms: number): string {
+  const d = new Date(ms);
+  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
+}
+
+function formatGap(minutes: number): string {
+  const m = Math.abs(minutes);
+  const days = Math.floor(m / 1440);
+  const h = Math.floor((m % 1440) / 60);
+  const min = m % 60;
+  const parts: string[] = [];
+  if (days) parts.push(`${days} j`);
+  if (h) parts.push(`${h} h`);
+  if (min || parts.length === 0) parts.push(`${min} min`);
+  return parts.join(' ');
+}
+
+export function StartPunctuality({ slideId, index }: { slideId: string; index: number }) {
+  const [planned, setPlanned] = useState<number | null>(() => readPlanned(slideId));
+  const [editing, setEditing] = useState(false);
+  const [draft, setDraft] = useState('');
+  // The comparison instant: refreshed on validation and on every slide change.
+  const [checkedAt, setCheckedAt] = useState(() => Date.now());
+
+  useEffect(() => {
+    setPlanned(readPlanned(slideId));
+  }, [slideId]);
+
+  useEffect(() => {
+    setCheckedAt(Date.now());
+  }, [index, planned]);
+
+  const validate = () => {
+    const ms = new Date(draft).getTime();
+    if (!draft || Number.isNaN(ms)) return;
+    try {
+      window.localStorage.setItem(storageKey(slideId), String(ms));
+    } catch {}
+    setPlanned(ms);
+    setEditing(false);
+  };
+
+  if (planned === null || editing) {
+    return (
+      <form
+        className="flex items-center gap-1.5"
+        onSubmit={(e) => {
+          e.preventDefault();
+          validate();
+        }}
+      >
+        <span className="font-mono text-[10px] tracking-[0.06em] uppercase text-white/45">
+          Début prévu
+        </span>
+        <input
+          type="datetime-local"
+          value={draft || toInputValue(planned ?? Date.now())}
+          onChange={(e) => setDraft(e.target.value)}
+          className="h-7 rounded-[3px] border border-white/15 bg-white/5 px-1.5 font-mono text-[12px] text-foreground [color-scheme:dark]"
+        />
+        <button
+          type="submit"
+          className="flex h-7 items-center gap-1 rounded-[3px] border border-white/20 bg-white/10 px-2 font-mono text-[11px] text-foreground hover:bg-white/20"
+        >
+          <Check className="size-3.5" /> Valider
+        </button>
+      </form>
+    );
+  }
+
+  const gap = Math.round((checkedAt - planned) / 60000);
+  const synchro = Math.abs(gap) <= TOLERANCE_MIN;
+  const late = gap > 0;
+  const tone = synchro
+    ? 'border-emerald-300/30 bg-emerald-300/10 text-emerald-200'
+    : late
+      ? 'border-rose-300/30 bg-rose-300/10 text-rose-200'
+      : 'border-sky-300/30 bg-sky-300/10 text-sky-200';
+  const label = synchro
+    ? `Synchrone${gap === 0 ? '' : ` (${late ? '+' : '−'}${formatGap(gap)})`}`
+    : late
+      ? `En retard de ${formatGap(gap)}`
+      : `En avance de ${formatGap(gap)}`;
+  const plannedText = new Date(planned).toLocaleString('fr-FR', {
+    day: '2-digit',
+    month: '2-digit',
+    hour: '2-digit',
+    minute: '2-digit',
+  });
+
+  return (
+    <div className="flex items-center gap-1.5">
+      <span
+        title={`Début prévu ${plannedText} · tolérance ±${TOLERANCE_MIN} min · mis à jour à chaque changement de slide`}
+        className={`rounded-[3px] border px-1.5 py-0.5 font-mono text-[12px] tabular-nums ${tone}`}
+      >
+        {plannedText} · {label}
+      </span>
+      <button
+        type="button"
+        title="Modifier l’heure de début"
+        onClick={() => {
+          setDraft(toInputValue(planned));
+          setEditing(true);
+        }}
+        className="rounded-[3px] p-1 text-white/45 hover:bg-white/10 hover:text-foreground"
+      >
+        <Pencil className="size-3.5" />
+      </button>
+    </div>
+  );
+}
