diff --git b/src/app/lib/pacing.ts b/src/app/lib/pacing.ts
new file mode 100644
index 0000000..b4e21a6
--- /dev/null
+++ b/src/app/lib/pacing.ts
@@ -0,0 +1,272 @@
+// Planned timeline of a deck, used by the presenter's punctuality badge.
+//
+// Each page gets a planned duration and a planned start, in minutes on the
+// deck's own clock. Sources, best first:
+//   1. Speaker-note header `⏱ N min` (or `⏱ A à B min`) — the author's own
+//      estimate; `⏱ (pendant l'atelier)` / `⏱ (support …)` pages take no time
+//      of their own (they are shown while the workshop timer runs).
+//   2. Clock anchors in that header — `· 13:30`, `(≈ 10 h 45)`,
+//      `fin vers 15:30`, `jusqu'à 16 h 00` — which pin the plan to the
+//      schedule, so breaks and lunch fall where the author put them.
+//   3. Without a `⏱` header: an estimate from the note's length (speaking
+//      pace), the number of reveal steps and any `<Timer minutes={N}>` the
+//      page renders.
+// A `COUVERTURE / ACCUEIL … JOUR N` header, or an anchor that jumps back in
+// time, starts a new training day; every day has its own planned start.
+
+export type PacingSlide = {
+  /** Planned duration of the page, minutes (0 = shown during a workshop). */
+  minutes: number;
+  /** Where `minutes` came from. */
+  source: 'notes' | 'estimate';
+  /** Training day (1-based). */
+  day: number;
+  /** Planned start / end, minutes on the deck clock, relative to its day start. */
+  start: number;
+  end: number;
+  /** Window in which being on this page counts as on schedule. */
+  windowStart: number;
+  windowEnd: number;
+};
+
+export type PacingDay = {
+  day: number;
+  first: number;
+  last: number;
+  /** Deck-clock time of day the plan assumes (minutes since midnight), if anchored. */
+  clockStart: number | null;
+  /** Planned length of the day, minutes. */
+  span: number;
+};
+
+export type PacingPlan = { slides: PacingSlide[]; days: PacingDay[] };
+
+const SPEAKING_WPM = 140;
+const MIN_ESTIMATE = 0.75;
+const NO_NOTES_ESTIMATE = 1;
+/** Gap between two anchors larger than the planned pages → a break before the later anchor. */
+const BREAK_MIN = 10;
+
+type Anchor = { at: number; kind: 'start' | 'end' };
+
+type Parsed = {
+  minutes: number | null;
+  during: boolean;
+  anchor: Anchor | null;
+  newDay: number | null;
+  words: number;
+  timer: number;
+};
+
+const CLOCK = /(\d{1,2})\s*(?::|h|H)\s*(\d{2})(?!\d)/g;
+
+function parseAnchor(header: string): Anchor | null {
+  for (const m of header.matchAll(CLOCK)) {
+    const h = Number(m[1]);
+    const min = Number(m[2]);
+    if (h < 6 || h > 21 || min > 59) continue;
+    const before = header.slice(0, m.index).toLowerCase();
+    // "pause à 14 h 15", "PAUSE DE 10 H 30", "avant 9 h 00", "(9 h 15 – 10 h 30)" end.
+    if (/(pause|avant|[–-])\s*(de|à|a|vers)?\s*$/.test(before)) continue;
+    const kind = /(fin[^·(,]*vers|jusqu['’]à|jusqu'a)\s*$/.test(before) ? 'end' : 'start';
+    return { at: h * 60 + min, kind };
+  }
+  return null;
+}
+
+function countWords(text: string): number {
+  return text.split(/\s+/).filter((w) => /[\p{L}\p{N}]/u.test(w)).length;
+}
+
+function parseTimer(source: string): number {
+  let best = 0;
+  for (const m of source.matchAll(/\bminutes\s*:\s*(\d{1,3}(?:\.\d+)?)\b/g)) {
+    const n = Number(m[1]);
+    if (n > 0 && n <= 180) best = Math.max(best, n);
+  }
+  return best;
+}
+
+function parseSlide(note: string | undefined, source: string): Parsed {
+  const text = (note ?? '').trim();
+  const header = text.startsWith('⏱') ? text.split('\n', 1)[0] : '';
+  let minutes: number | null = null;
+  let during = false;
+  if (header) {
+    const range = header.match(/⏱\s*(\d+(?:[.,]\d+)?)\s*(?:à|-|–)\s*(\d+(?:[.,]\d+)?)\s*min/);
+    const single = header.match(/⏱\s*(\d+(?:[.,]\d+)?)\s*min/);
+    const hours = header.match(/⏱\s*(\d+)\s*h\s*(\d{2})?(?!\s*\d)/);
+    const lead = header.split('·', 1)[0];
+    if (range) minutes = (Number(range[1].replace(',', '.')) + Number(range[2].replace(',', '.'))) / 2;
+    else if (single && lead.includes('+')) {
+      // "⏱ 3 min de démonstration + 10 min en autonomie"
+      minutes = [...lead.matchAll(/(\d+(?:[.,]\d+)?)\s*min/g)].reduce(
+        (s, m) => s + Number(m[1].replace(',', '.')),
+        0,
+      );
+    } else if (single) minutes = Number(single[1].replace(',', '.'));
+    else if (hours) minutes = Number(hours[1]) * 60 + Number(hours[2] ?? 0);
+    else if (/⏱\s*\(/.test(header)) {
+      minutes = 0;
+      during = true;
+    }
+  }
+  const dayMatch = header.match(
+    /(couverture|accueil|bienvenue|ouverture)[^\n]*?\b(?:jour|j)\s?([2-9])\b/i,
+  );
+  return {
+    minutes,
+    during,
+    anchor: header ? parseAnchor(header.replace(/^⏱[^·(]*/, '')) : null,
+    newDay: dayMatch ? Number(dayMatch[2]) : null,
+    words: countWords(text),
+    timer: parseTimer(source),
+  };
+}
+
+function pageSource(page: unknown): string {
+  try {
+    return typeof page === 'function' ? Function.prototype.toString.call(page) : '';
+  } catch {
+    return '';
+  }
+}
+
+function estimate(p: Parsed): number {
+  const spoken = p.words ? Math.max(MIN_ESTIMATE, p.words / SPEAKING_WPM) : NO_NOTES_ESTIMATE;
+  return p.timer ? Math.max(spoken, p.timer + 1) : spoken;
+}
+
+export function buildPacingPlan(
+  pages: readonly unknown[],
+  notes: readonly (string | undefined)[] | undefined,
+): PacingPlan {
+  const parsed = pages.map((page, i) => parseSlide(notes?.[i], pageSource(page)));
+  const slides: PacingSlide[] = parsed.map((p) => ({
+    minutes: p.minutes ?? estimate(p),
+    source: p.minutes === null ? 'estimate' : 'notes',
+    day: 1,
+    start: 0,
+    end: 0,
+    windowStart: 0,
+    windowEnd: 0,
+  }));
+
+  // Split into days.
+  const days: PacingDay[] = [];
+  let day = 1;
+  let first = 0;
+  let lastAnchor = -1;
+  const closeDay = (last: number) => {
+    if (last >= first) days.push({ day, first, last, clockStart: null, span: 0 });
+  };
+  parsed.forEach((p, i) => {
+    const anchorAt = p.anchor ? p.anchor.at : null;
+    const jumpsBack = anchorAt !== null && lastAnchor >= 0 && anchorAt < lastAnchor - 120;
+    const explicit = p.newDay !== null && p.newDay > day;
+    if (i > first && (explicit || jumpsBack)) {
+      closeDay(i - 1);
+      day = explicit ? (p.newDay as number) : day + 1;
+      first = i;
+      lastAnchor = -1;
+    }
+    if (anchorAt !== null) lastAnchor = anchorAt;
+    slides[i].day = day;
+  });
+  closeDay(pages.length - 1);
+
+  for (const d of days) layoutDay(d, parsed, slides);
+  return { slides, days };
+}
+
+function layoutDay(d: PacingDay, parsed: Parsed[], slides: PacingSlide[]) {
+  // Anchors as planned starts (an end anchor pins the page's end).
+  const anchors: { i: number; at: number }[] = [];
+  for (let i = d.first; i <= d.last; i++) {
+    const a = parsed[i].anchor;
+    if (!a) continue;
+    const at = a.kind === 'end' ? a.at - slides[i].minutes : a.at;
+    const prev = anchors[anchors.length - 1];
+    if (prev && at <= prev.at) continue; // out-of-order anchor: ignore it
+    anchors.push({ i, at });
+  }
+
+  const sum = (from: number, to: number) => {
+    let s = 0;
+    for (let i = from; i < to; i++) s += slides[i].minutes;
+    return s;
+  };
+
+  // Deck-clock start of the day: back-computed from the first anchor.
+  const origin = anchors.length ? anchors[0].at - sum(d.first, anchors[0].i) : 0;
+  d.clockStart = anchors.length ? origin : null;
+
+  // Lay out each segment between anchors.
+  const cuts = [{ i: d.first, at: origin }, ...anchors.filter((a) => a.i > d.first)];
+  for (let k = 0; k < cuts.length; k++) {
+    const from = cuts[k].i;
+    const to = k + 1 < cuts.length ? cuts[k + 1].i : d.last + 1;
+    const planned = sum(from, to);
+    const available = k + 1 < cuts.length ? cuts[k + 1].at - cuts[k].at : planned;
+    // Slack under BREAK_MIN is authoring imprecision: spread it. More is a
+    // break: keep the pace and leave the gap before the next anchor.
+    const scale =
+      planned > 0 && (available < planned || available - planned < BREAK_MIN)
+        ? available / planned
+        : 1;
+    let t = cuts[k].at - origin;
+    for (let i = from; i < to; i++) {
+      slides[i].start = t;
+      t += slides[i].minutes * scale;
+      slides[i].end = t;
+    }
+  }
+  d.span = slides[d.last].end;
+
+  // "During the workshop" pages share the window of the timed pages around them.
+  for (let i = d.first; i <= d.last; i++) {
+    const s = slides[i];
+    s.windowStart = s.start;
+    s.windowEnd = s.end;
+    if (!parsed[i].during) continue;
+    let a = i - 1;
+    while (a >= d.first && parsed[a].during) a--;
+    let b = i + 1;
+    while (b <= d.last && parsed[b].during) b++;
+    s.windowStart = a >= d.first ? slides[a].start : s.start;
+    s.windowEnd = b <= d.last ? slides[b].end : s.end;
+  }
+}
+
+/** Gap in minutes between now and the plan for page `index`: > 0 late, < 0 early, 0 inside the window. */
+export function pacingGap(
+  plan: PacingPlan,
+  index: number,
+  dayStartMs: number,
+  now: number,
+  scale = 1,
+): number {
+  const s = plan.slides[index];
+  if (!s) return 0;
+  const elapsed = (now - dayStartMs) / 60000;
+  if (elapsed < s.windowStart * scale) return elapsed - s.windowStart * scale;
+  if (elapsed > s.windowEnd * scale) return elapsed - s.windowEnd * scale;
+  return 0;
+}
+
+/** Page the plan expects to be on at `now`. */
+export function expectedIndex(
+  plan: PacingPlan,
+  day: number,
+  dayStartMs: number,
+  now: number,
+  scale = 1,
+): number {
+  const d = plan.days.find((x) => x.day === day);
+  if (!d) return 0;
+  const elapsed = (now - dayStartMs) / 60000;
+  for (let i = d.first; i <= d.last; i++) {
+    if (elapsed < plan.slides[i].end * scale) return i;
+  }
+  return d.last;
+}
