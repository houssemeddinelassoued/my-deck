+                  value={layout.side}
+                  min={MIN_SIDE_PCT}
+                  max={MAX_SIDE_PCT}
+                  className="h-4"
+                  onResizeStart={() => {
+                    dragStartRef.current = sizeOf(sideTopRef.current, 'height');
+                  }}
+                  onResize={(delta) => {
+                    const total = sizeOf(sideRef.current, 'height');
