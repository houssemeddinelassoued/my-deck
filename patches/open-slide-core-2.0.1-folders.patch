+    setOverrides(res.overrides);
+    setRecalNote(
+      res.count === 0
+        ? 'Aucun minuteur à venir dans cette journée.'
+        : `Recalé : ${res.count} minuteur${res.count > 1 ? 's' : ''} à venir × ${res.factor.toFixed(2)} · reste ${formatGap(res.available)}`,
+    );
+  };
+
+  const setTimerMinutes = (timer: DeckTimer, minutes: number) => {
+    const next = { ...overrides, [timer.id]: Math.max(1, Math.round(minutes)) };
+    writeTimerOverrides(slideId, next);
+    setOverrides(next);
+  };
