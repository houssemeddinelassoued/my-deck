+// Project patch — bouton « Liens » de la barre d'outils de l'éditeur : un menu des
+// liens utiles (un clic = copié pour le Chat) et « Gérer les liens… » (fenêtre).
+import { BookMarked, Copy, ExternalLink, Settings2 } from 'lucide-react';
+import { useState } from 'react';
+import { toast } from 'sonner';
+import { buttonVariants } from '@/components/ui/button';
+import { Dialog, DialogContent, DialogHeader, DialogTitle } from '@/components/ui/dialog';
+import {
+  DropdownMenu,
+  DropdownMenuContent,
+  DropdownMenuGroup,
+  DropdownMenuItem,
+  DropdownMenuLabel,
+  DropdownMenuSeparator,
+  DropdownMenuTrigger,
+} from '@/components/ui/dropdown-menu';
+import { useLocale } from '@/lib/use-locale';
+import { cn } from '@/lib/utils';
+import { CAN_EDIT_LINKS, DEFAULT_GROUP, hostOf, linksToChat, useLinks } from '../lib/links';
+import { LinksManager } from './links-manager';
+
+export function LinksToolbarButton({ slideId }: { slideId: string }) {
+  const t = useLocale().toolbox;
+  const { groups, count } = useLinks(slideId);
+  const [manageOpen, setManageOpen] = useState(false);
+
+  // Rien à montrer, et rien à éditer (build de production) : pas de bouton.
+  if (count === 0 && !CAN_EDIT_LINKS) return null;
+
+  const copy = async (text: string) => {
+    try {
+      await navigator.clipboard.writeText(text);
+      toast.success(t.linksCopied);
+    } catch {
+      toast.error(t.linksSaveError);
+    }
+  };
+
+  return (
+    <>
+      <DropdownMenu>
+        <DropdownMenuTrigger
+          type="button"
+          aria-label={t.linksButton}
+          title={t.linksButton}
+          className={cn(
+            buttonVariants({ variant: 'ghost', size: 'sm' }),
+            'hidden h-7 gap-1.5 rounded-md px-2 text-[12px] md:inline-flex',
+          )}
+        >
+          <BookMarked className="size-3.5" />
+          {t.linksButton}
+        </DropdownMenuTrigger>
+        <DropdownMenuContent align="end" className="max-h-[70vh] min-w-[280px] max-w-[380px] overflow-y-auto">
+          {groups.map((g, i) => (
+            <div key={g.name}>
+              {i > 0 && <DropdownMenuSeparator />}
+              <DropdownMenuGroup>
+              <DropdownMenuLabel>{g.name === DEFAULT_GROUP ? t.linksDefaultGroup : g.name}</DropdownMenuLabel>
+              {g.links.map((l) => (
+                <DropdownMenuItem key={l.url} onClick={() => copy(linksToChat([l]))} title={l.url}>
+                  <Copy />
+                  <span className="min-w-0 flex-1 truncate">{l.label}</span>
+                  <span className="shrink-0 font-mono text-[10.5px] text-muted-foreground">{hostOf(l.url)}</span>
+                  <a
+                    href={l.url}
+                    target="_blank"
+                    rel="noopener noreferrer"
+                    aria-label={t.linksOpen}
+                    title={t.linksOpen}
+                    onClick={(e) => e.stopPropagation()}
+                    className="inline-flex size-5 shrink-0 items-center justify-center rounded text-muted-foreground hover:bg-muted hover:text-foreground"
+                  >
+                    <ExternalLink className="size-3.5" />
+                  </a>
+                </DropdownMenuItem>
+              ))}
+              <DropdownMenuItem onClick={() => copy(linksToChat(g.links))}>
+                <Copy />
+                {t.linksCopyGroup}
+              </DropdownMenuItem>
+              </DropdownMenuGroup>
+            </div>
+          ))}
+          {count > 0 && <DropdownMenuSeparator />}
+          <DropdownMenuItem onClick={() => setManageOpen(true)}>
+            <Settings2 />
+            {t.linksManage}
+          </DropdownMenuItem>
+        </DropdownMenuContent>
+      </DropdownMenu>
+
+      <Dialog open={manageOpen} onOpenChange={setManageOpen}>
+        <DialogContent className="max-h-[85vh] max-w-xl overflow-y-auto sm:max-w-xl">
+          <DialogHeader>
+            <DialogTitle>{t.linksButton}</DialogTitle>
+          </DialogHeader>
+          <LinksManager slideId={slideId} />
+        </DialogContent>
+      </Dialog>
+    </>
+  );
+}
