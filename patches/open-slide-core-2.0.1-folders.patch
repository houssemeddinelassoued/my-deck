+  const [draft, setDraft] = useState('');
+  const [kind, setKind] = useState<NoteKind>('note');
+  const [scope, setScope] = useState<'page' | 'all'>('all');
+  const [editing, setEditing] = useState<{ id: string; text: string; kind: NoteKind } | null>(null);
+  const [copied, setCopied] = useState(false);
+  const [file, setFile] = useState<'idle' | 'saving' | 'saved' | 'error'>('idle');
+  const fileTimer = useRef<number | undefined>(undefined);
+  const days = useMemo(
+    () => Array.from(new Set([today, ...listSessionDays(slideId)])).sort().reverse(),
+    [slideId, today],
+  );
+  const kindLabel: Record<NoteKind, string> = {
+    note: t.kindNote,
+    question: t.kindQuestion,
+    review: t.kindReview,
+    idea: t.kindIdea,
+  };
+
+  useEffect(() => {
+    setNotes(loadSessionNotes(slideId, day));
+    setEditing(null);
+    setFile('idle');
+  }, [slideId, day]);
+  useEffect(() => () => window.clearTimeout(fileTimer.current), []);
+
+  const titleOf = (p: number) => slideTitleFromNote(speakerNotes?.[p]);
+  const markdown = (list: SessionNote[]) =>
+    notesToMarkdown(
+      { title: t.mdTitle, date: t.mdDate, slide: t.notesSlide, none: t.mdNone, kinds: kindLabel },
+      slideTitle,
+      day,
+      list,
+      titleOf,
+    );
+
+  const persist = (next: SessionNote[]) => {
+    setNotes(next);
+    saveSessionNotes(slideId, day, next);
+    // Copie fichier dans docs/sessions/ (serveur de dev), regroupée.
+    window.clearTimeout(fileTimer.current);
+    setFile('saving');
+    fileTimer.current = window.setTimeout(() => {
+      writeSessionFile(slideId, day, markdown(next)).then(
+        () => setFile('saved'),
+        () => setFile('error'),
+      );
+    }, 800);
+  };
+  const add = () => {
+    const text = draft.trim();
+    if (!text || day !== today) return;
+    persist([...notes, { id: Math.random().toString(36).slice(2, 10), page: index, text, at: Date.now(), kind }]);
+    setDraft('');
+  };
+  const saveEdit = () => {
+    if (!editing) return;
+    const text = editing.text.trim();
+    persist(
+      text
+        ? notes.map((n) => (n.id === editing.id ? { ...n, text, kind: editing.kind } : n))
+        : notes.filter((n) => n.id !== editing.id),
+    );
+    setEditing(null);
+  };
+
+  const shown = notes.filter((n) => scope === 'all' || n.page === index).sort((a, b) => b.at - a.at);
+  const pagesWithNotes = Array.from(new Set(notes.map((n) => n.page))).sort((a, b) => a - b);
+
+  const download = () => {
+    const url = URL.createObjectURL(new Blob([markdown(notes)], { type: 'text/markdown;charset=utf-8' }));
+    const a = document.createElement('a');
+    a.href = url;
+    a.download = `notes-${slideId}-${day}.md`;
+    document.body.appendChild(a);
+    a.click();
+    a.remove();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  };
+  const copy = async () => {
+    try {
+      await navigator.clipboard.writeText(markdown(notes));
+      setCopied(true);
+      setTimeout(() => setCopied(false), 1500);
+    } catch {}
+  };
+
+  return (
+    <div>
+      <div className="mb-2 flex items-center gap-2">
+        <span className="eyebrow">{t.notesLabel}</span>
+        <select
+          value={day}
+          onChange={(e) => setDay(e.target.value)}
+          className={fieldCls('ml-auto py-1 text-[11.5px]')}
+          aria-label={t.tabNotes}
+        >
+          {days.map((d) => (
+            <option key={d} value={d}>
+              {d === today ? format(t.notesToday, { day: d }) : d}
+            </option>
+          ))}
+        </select>
+      </div>
+
+      {day === today && (
+        <>
+          <KindPicker value={kind} onChange={setKind} labels={kindLabel} />
+          <textarea
+            value={draft}
+            onChange={(e) => setDraft(e.target.value)}
+            onKeyDown={(e) => {
+              if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
+                e.preventDefault();
+                add();
+              } else if (e.key === 'Escape') {
+                e.currentTarget.blur();
+              }
+            }}
+            placeholder={format(t.notesPlaceholder, { n: index + 1 })}
+            rows={3}
+            className={fieldCls('mt-1.5 w-full resize-y')}
+          />
+          <div className="mt-1.5 mb-3 flex items-center gap-2">
+            <Button size="sm" variant="brand" disabled={!draft.trim()} onMouseDown={noFocus} onClick={add}>
+              {format(t.notesAdd, { n: index + 1 })}
+            </Button>
+            <span className="text-[11px] text-muted-foreground">Ctrl+↵</span>
+          </div>
+        </>
+      )}
+
+      {pagesWithNotes.length > 0 && (
+        <>
+          <FieldLabel first>{t.notesSlidesWith}</FieldLabel>
+          <div className="mb-3 flex flex-wrap gap-1">
+            {pagesWithNotes.map((p) => (
+              <Button
+                key={p}
+                size="xs"
+                variant={p === index ? 'default' : 'outline'}
+                className="font-mono tabular-nums"
+                title={titleOf(p) || format(t.notesSlide, { n: p + 1 })}
+                onMouseDown={noFocus}
+                onClick={() => onJump(p)}
+              >
+                {p + 1}
+              </Button>
+            ))}
+          </div>
+        </>
+      )}
+
+      <div className="mb-1.5 flex gap-1">
+        <Button size="xs" variant={scope === 'page' ? 'default' : 'ghost'} onMouseDown={noFocus} onClick={() => setScope('page')}>
+          {t.notesThisSlide}
+        </Button>
+        <Button size="xs" variant={scope === 'all' ? 'default' : 'ghost'} onMouseDown={noFocus} onClick={() => setScope('all')}>
+          {format(t.notesAll, { n: notes.length })}
+        </Button>
+      </div>
+
+      <div className="grid gap-1.5">
+        {shown.length === 0 && <div className="py-2 text-[12px] text-muted-foreground">{t.notesEmpty}</div>}
+        {shown.map((n) =>
+          editing?.id === n.id ? (
+            <div key={n.id} className="rounded-[6px] border border-foreground/25 p-2">
+              <KindPicker value={editing.kind} onChange={(k) => setEditing({ ...editing, kind: k })} labels={kindLabel} />
+              <textarea
+                // biome-ignore lint/a11y/noAutofocus: the user just asked to edit this note
+                autoFocus
+                value={editing.text}
+                onChange={(e) => setEditing({ ...editing, text: e.target.value })}
+                onKeyDown={(e) => {
+                  if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
+                    e.preventDefault();
+                    saveEdit();
+                  } else if (e.key === 'Escape') {
+                    e.preventDefault();
+                    setEditing(null);
+                  }
+                }}
+                rows={3}
+                className={fieldCls('mt-1.5 w-full resize-y')}
+              />
+              <div className="mt-1.5 flex gap-1.5">
+                <Button size="xs" variant="brand" onMouseDown={noFocus} onClick={saveEdit}>
+                  <Check /> {t.notesSave}
+                </Button>
+                <Button size="xs" variant="ghost" onMouseDown={noFocus} onClick={() => setEditing(null)}>
+                  {t.notesCancel}
+                </Button>
+              </div>
+            </div>
+          ) : (
+            <div key={n.id} className="group/note rounded-[6px] border border-hairline px-2.5 py-1.5">
+              <div className="mb-0.5 flex items-center gap-2 text-[11px] text-muted-foreground">
+                <span className={cn('size-1.5 rounded-full', KIND_DOT[n.kind ?? 'note'])} />
+                <span>{kindLabel[n.kind ?? 'note']}</span>
+                <button
+                  type="button"
+                  className="font-mono tabular-nums underline-offset-2 hover:text-foreground hover:underline"
+                  title={titleOf(n.page)}
+                  onClick={() => onJump(n.page)}
+                >
+                  {format(t.notesSlide, { n: n.page + 1 })}
+                </button>
+                <span className="font-mono tabular-nums">{fmtTime(n.at)}</span>
+                <span className="ml-auto flex gap-0.5 opacity-60 group-hover/note:opacity-100">
+                  <Button
+                    size="icon-xs"
+                    variant="ghost"
+                    title={t.notesEdit}
+                    aria-label={t.notesEdit}
+                    onMouseDown={noFocus}
+                    onClick={() => setEditing({ id: n.id, text: n.text, kind: n.kind ?? 'note' })}
+                  >
+                    <Pencil />
+                  </Button>
+                  <Button
+                    size="icon-xs"
+                    variant="ghost"
+                    title={t.notesDelete}
+                    aria-label={t.notesDelete}
+                    onMouseDown={noFocus}
+                    onClick={() => persist(notes.filter((x) => x.id !== n.id))}
+                  >
+                    <X />
+                  </Button>
+                </span>
+              </div>
+              <div className="text-[13px] leading-snug whitespace-pre-wrap">{n.text}</div>
+            </div>
+          ),
+        )}
+      </div>
+
+      <div className="mt-3 flex items-center gap-1.5">
+        <Button size="sm" variant="outline" disabled={notes.length === 0} onMouseDown={noFocus} onClick={download}>
+          <Download /> {t.notesExport}
+        </Button>
+        <Button size="sm" variant="ghost" disabled={notes.length === 0} onMouseDown={noFocus} onClick={copy}>
+          {copied ? <Check /> : <Copy />} {copied ? t.notesCopied : t.notesCopy}
+        </Button>
+      </div>
+      {file !== 'idle' && (
+        <p
+          className={cn(
+            'mt-2 text-[11px] leading-snug',
+            file === 'error' ? 'text-amber-300/90' : 'text-muted-foreground',
+          )}
+        >
+          {file === 'saving'
+            ? t.fileSaving
+            : file === 'saved'
+              ? format(t.fileSaved, { path: sessionFilePath(slideId, day) })
+              : t.fileError}
+        </p>
+      )}
+    </div>
+  );
+}
+
+function KindPicker({
+  value,
+  onChange,
+  labels,
+}: {
+  value: NoteKind;
+  onChange: (k: NoteKind) => void;
+  labels: Record<NoteKind, string>;
+}) {
+  return (
+    <div className="flex flex-wrap gap-1">
+      {NOTE_KINDS.map((k) => (
+        <Button key={k} size="xs" variant={value === k ? 'default' : 'outline'} onMouseDown={noFocus} onClick={() => onChange(k)}>
+          <span className={cn('size-1.5 rounded-full', KIND_DOT[k])} />
+          {labels[k]}
+        </Button>
+      ))}
+    </div>
+  );
+}
+
+// ───────────────────────── Petits éléments ─────────────────────────
+
+const noFocus = (e: { preventDefault: () => void }) => e.preventDefault();
+
+const fieldCls = (extra = '') =>
+  cn(
+    'rounded-[5px] border border-border bg-background px-2 py-1.5 text-[12.5px] text-foreground outline-none placeholder:text-muted-foreground/70 focus-visible:border-foreground/30',
+    extra,
+  );
+
+function FieldLabel({ children, first }: { children: ReactNode; first?: boolean }) {
+  return <div className={cn('eyebrow mb-1.5', !first && 'mt-3.5')}>{children}</div>;
+}
+
+function BigClock({
+  value,
+  tone,
+  blink,
+  fraction,
+}: {
+  value: string;
+  tone: 'idle' | 'ok' | 'warn' | 'bad';
+  blink?: boolean;
+  fraction?: number | null;
+}) {
+  const color = {
+    idle: 'text-foreground',
+    ok: 'text-emerald-300',
+    warn: 'text-amber-300',
+    bad: 'text-red-400',
+  }[tone];
+  const bar = { idle: 'bg-foreground/40', ok: 'bg-emerald-400', warn: 'bg-amber-400', bad: 'bg-red-500' }[tone];
+  return (
+    <div>
+      <div
+        className={cn('text-center font-mono text-[50px] leading-none font-semibold tabular-nums', color)}
+        style={blink ? { animation: 'osd-tb-blink 1s infinite' } : undefined}
+      >
+        {value}
+      </div>
+      {fraction != null && (
+        <div className="mx-auto mt-2 h-1 w-3/4 overflow-hidden rounded-full bg-muted">
+          <div className={cn('h-full transition-[width] duration-200', bar)} style={{ width: `${fraction * 100}%` }} />
+        </div>
+      )}
+    </div>
+  );
+}
+
+function beep(times: number) {
+  try {
+    const Ctx =
+      window.AudioContext ??
+      (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
+    if (!Ctx) return;
+    const ctx = new Ctx();
+    for (let i = 0; i < times; i++) {
+      const osc = ctx.createOscillator();
+      const gain = ctx.createGain();
+      osc.frequency.value = times > 1 ? 880 : 660;
+      gain.gain.value = 0.15;
+      osc.connect(gain).connect(ctx.destination);
+      osc.start(ctx.currentTime + i * 0.35);
+      osc.stop(ctx.currentTime + i * 0.35 + 0.22);
+    }
+    setTimeout(() => ctx.close().catch(() => {}), 1500 + times * 400);
+  } catch {}
+}
