+// ───────────────────────── Outils ─────────────────────────
+
+function CountdownTool({
+  t,
+  label,
+  hint,
+  c,
+  now,
+  presets,
+  onChange,
+}: {
+  t: Strings;
+  label: string;
+  hint: string;
+  c: Countdown;
+  now: number;
+  presets: number[];
+  onChange: (fn: (c: Countdown) => Countdown) => void;
+}) {
+  const done = isFinished(c, now);
+  const warn = isWarning(c, now);
+  const running = isRunning(c) && !done;
+  return (
+    <div>
+      <FieldLabel first>{label}</FieldLabel>
+      <BigClock
+        value={fmtClock(remainingMs(c, now))}
+        tone={done ? 'bad' : warn ? 'warn' : running ? 'ok' : 'idle'}
+        blink={done}
+        fraction={isActive(c) ? fractionLeft(c, now) : null}
+      />
+      <div className="mt-2.5 flex justify-center gap-1.5">
+        {running ? (
+          <Button size="sm" variant="outline" onMouseDown={noFocus} onClick={() => onChange((x) => pauseCountdown(x, Date.now()))}>
+            <Pause /> {t.pause}
+          </Button>
+        ) : (
+          <Button size="sm" variant="brand" onMouseDown={noFocus} onClick={() => onChange((x) => startCountdown(x, Date.now()))}>
+            <Play /> {isPaused(c) ? t.resume : t.start}
+          </Button>
+        )}
+        <Button size="sm" variant="outline" disabled={!isActive(c)} onMouseDown={noFocus} onClick={() => onChange(resetCountdown)}>
+          <RotateCcw /> {t.stop}
+        </Button>
+      </div>
+      <div className="mt-2 flex justify-center gap-1">
+        {[-5, -1, 1, 5].map((m) => (
+          <Button
+            key={m}
+            size="xs"
+            variant="ghost"
+            className="font-mono tabular-nums"
+            onMouseDown={noFocus}
+            onClick={() => onChange((x) => adjustCountdown(x, m * 60_000, Date.now()))}
+          >
+            {m > 0 ? `+${m}` : `−${-m}`} min
+          </Button>
+        ))}
+      </div>
+      <FieldLabel>{t.duration}</FieldLabel>
+      <div className="flex flex-wrap gap-1">
+        {presets.map((m) => (
+          <Button
+            key={m}
+            size="xs"
+            variant={c.durationMs === m * 60_000 ? 'default' : 'outline'}
+            onMouseDown={noFocus}
+            onClick={() => onChange((x) => setDuration(x, m * 60_000))}
+          >
+            {format(t.minutes, { n: m })}
+          </Button>
+        ))}
+      </div>
+      <p className="mt-2 text-[11px] leading-snug text-muted-foreground">{hint}</p>
+    </div>
+  );
+}
+
+/** Heure « HH:MM » du jour → epoch ms (null si invalide). */
+function parseClock(value: string): number | null {
+  const m = /^(\d{1,2}):(\d{2})$/.exec(value);
+  if (!m) return null;
+  const d = new Date();
+  d.setHours(Number(m[1]), Number(m[2]), 0, 0);
+  return d.getTime();
+}
+
+function PauseUntil({ t, onStart }: { t: Strings; onStart: (endAt: number) => void }) {
+  const [value, setValue] = useState('');
+  // Ré-évalue la validité chaque seconde tant qu'une heure est saisie.
+  const now = useNow(value !== '', 1000);
+  const endAt = parseClock(value);
+  const diff = endAt == null ? null : endAt - now;
+  const status =
+    diff == null ? null : diff < 60_000 ? 'past' : diff > MAX_UNTIL_MS ? 'tooLong' : 'ok';
+  const go = () => {
+    if (status === 'ok' && endAt != null) {
+      onStart(endAt);
+      setValue('');
+    }
+  };
+  return (
+    <>
+      <FieldLabel>{t.pauseUntil}</FieldLabel>
+      <div className="flex gap-1.5">
+        <input
+          type="time"
+          value={value}
+          onChange={(e) => setValue(e.target.value)}
+          onKeyDown={(e) => e.key === 'Enter' && go()}
+          className={fieldCls('w-28 font-mono')}
+        />
+        <Button size="sm" variant="outline" disabled={status !== 'ok'} onMouseDown={noFocus} onClick={go}>
+          <Play /> {t.pauseUntilGo}
+        </Button>
+      </div>
+      {status && (
+        <p
+          className={cn(
+            'mt-1.5 text-[11px]',
+            status === 'ok' ? 'text-muted-foreground' : 'text-amber-300/90',
+          )}
+        >
+          {status === 'ok'
+            ? format(t.pauseUntilIn, { n: Math.round((diff ?? 0) / 60_000) })
+            : status === 'past'
+              ? t.pauseUntilPast
+              : t.pauseUntilTooLong}
+        </p>
+      )}
+    </>
+  );
+}
+
+function BeepOptions({ t, state, update }: { t: Strings; state: ToolboxState; update: ToolboxUpdate }) {
+  return (
+    <div className="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-[11.5px] text-muted-foreground">
+      <label className="flex cursor-pointer items-center gap-1.5">
+        <input
+          type="checkbox"
+          checked={state.warnBeep}
+          onChange={(e) => update((s) => ({ ...s, warnBeep: e.target.checked }))}
+        />
+        {t.warnBeep}
+      </label>
+      <label className="flex cursor-pointer items-center gap-1.5">
+        <input
+          type="checkbox"
+          checked={state.endBeep}
+          onChange={(e) => update((s) => ({ ...s, endBeep: e.target.checked }))}
+        />
+        {t.endBeep}
+      </label>
+    </div>
+  );
+}
+
+function ChronoTool({
+  t,
+  s,
+  now,
+  onChange,
+}: {
+  t: Strings;
+  s: Stopwatch;
+  now: number;
+  onChange: (fn: (s: Stopwatch) => Stopwatch) => void;
