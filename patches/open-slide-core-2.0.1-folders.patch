@@ -0,0 +1,322 @@
+// Project patch — liste des liens utiles du formateur : copier pour le Chat,
+// ouvrir, afficher en projection, ajouter / modifier / supprimer.
+// Utilisé dans l'onglet « Liens » de la boîte à outils (vue présentateur) et dans
+// la fenêtre « Gérer les liens » de l'éditeur.
+import { Check, Copy, ExternalLink, Pencil, Plus, Presentation, X } from 'lucide-react';
+import { useId, useState } from 'react';
+import { Button } from '@/components/ui/button';
+import { useLocale } from '@/lib/use-locale';
+import { cn } from '@/lib/utils';
+import {
+  CAN_EDIT_LINKS,
+  DEFAULT_GROUP,
+  hostOf,
+  isHttpUrl,
+  type Link,
+  type LinkScope,
+  type ScopedLink,
+  linksToChat,
+  useLinks,
+} from '../lib/links';
+
+type Props = {
+  slideId: string;
+  /** URL du lien actuellement affiché en projection (présentateur seulement). */
+  projectedUrl?: string | null;
+  /** Fourni = le bouton « Afficher en projection » existe. null = masquer. */
+  onProject?: (link: Link | null) => void;
+};
+
+const noFocus = (e: { preventDefault: () => void }) => e.preventDefault();
+const field =
+  'rounded-[5px] border border-border bg-background px-2 py-1.5 text-[12.5px] text-foreground outline-none placeholder:text-muted-foreground/70 focus-visible:border-foreground/30';
+
+export function LinksManager({ slideId, projectedUrl, onProject }: Props) {
+  const t = useLocale().toolbox;
+  const { global, deck, groups, count, save } = useLinks(slideId);
+  const [copied, setCopied] = useState<string | null>(null);
+  const [form, setForm] = useState<{ original: ScopedLink | null } | null>(null);
+  const [error, setError] = useState('');
+
+  const copy = async (key: string, text: string) => {
+    try {
+      await navigator.clipboard.writeText(text);
+      setCopied(key);
+      setTimeout(() => setCopied((c) => (c === key ? null : c)), 1400);
+    } catch {}
+  };
+
+  const listOf = (scope: LinkScope) => (scope === 'deck' ? deck : global);
+  const run = async (fn: () => Promise<void>) => {
+    setError('');
+    try {
+      await fn();
+    } catch (e) {
+      setError(`${t.linksSaveError} : ${String((e as Error).message ?? e)}`);
+    }
+  };
+  const remove = (l: ScopedLink) =>
+    run(() =>
+      save(
+        l.scope,
+        listOf(l.scope).filter((x) => x.url !== l.url),
+      ),
+    );
+  const submit = (next: Link, scope: LinkScope, original: ScopedLink | null) =>
+    run(async () => {
+      if (original && original.scope === scope) {
+        await save(
+          scope,
+          listOf(scope).map((x) => (x.url === original.url ? next : x)),
+        );
+      } else {
+        if (original) {
+          await save(
+            original.scope,
+            listOf(original.scope).filter((x) => x.url !== original.url),
+          );
+        }
+        await save(scope, [...listOf(scope).filter((x) => x.url !== next.url), next]);
+      }
+      setForm(null);
+    });
+
+  const all = groups.flatMap((g) => g.links);
+
+  return (
+    <div>
+      {all.length === 0 && <p className="py-2 text-[12px] text-muted-foreground">{t.linksEmpty}</p>}
+
+      <div className="grid gap-3.5">
+        {groups.map((g) => (
+          <section key={g.name}>
+            <div className="mb-1 flex items-center gap-2">
+              <span className="eyebrow">{g.name === DEFAULT_GROUP ? t.linksDefaultGroup : g.name}</span>
+              <Button
+                size="xs"
+                variant="ghost"
+                className="ml-auto"
+                onMouseDown={noFocus}
+                onClick={() => copy(`g:${g.name}`, linksToChat(g.links))}
+              >
+                {copied === `g:${g.name}` ? <Check /> : <Copy />}
+                {copied === `g:${g.name}` ? t.linksCopied : t.linksCopyGroup}
+              </Button>
+            </div>
+            <ul className="grid gap-1">
+              {g.links.map((l) => {
+                const projected = projectedUrl === l.url;
+                return (
+                  <li
+                    key={l.url}
+                    className={cn(
+                      'group/link flex items-center gap-1.5 rounded-[6px] border px-2 py-1',
+                      projected ? 'border-sky-400/60 bg-sky-400/10' : 'border-hairline',
+                    )}
+                  >
+                    <div className="min-w-0 flex-1">
+                      <div className="truncate text-[12.5px] font-medium" title={l.label}>
+                        {l.label}
+                      </div>
+                      <div className="truncate font-mono text-[10.5px] text-muted-foreground" title={l.url}>
+                        {hostOf(l.url)}
+                        {l.scope === 'deck' && ' · ' + t.linksScopeDeck.toLowerCase()}
+                      </div>
+                    </div>
+                    <Button
+                      size="icon-xs"
+                      variant="ghost"
+                      title={t.linksCopy}
+                      aria-label={t.linksCopy}
+                      onMouseDown={noFocus}
+                      onClick={() => copy(l.url, linksToChat([l]))}
+                    >
+                      {copied === l.url ? <Check /> : <Copy />}
+                    </Button>
+                    <a
+                      href={l.url}
+                      target="_blank"
+                      rel="noopener noreferrer"
+                      title={t.linksOpen}
+                      aria-label={t.linksOpen}
+                      className="inline-flex size-6 items-center justify-center rounded-[5px] text-foreground/75 hover:bg-muted hover:text-foreground"
+                    >
+                      <ExternalLink className="size-3.5" />
+                    </a>
+                    {onProject && (
+                      <Button
+                        size="icon-xs"
+                        variant={projected ? 'default' : 'ghost'}
+                        title={projected ? t.linksHideProjection : t.linksProject}
+                        aria-label={projected ? t.linksHideProjection : t.linksProject}
+                        aria-pressed={projected}
+                        onMouseDown={noFocus}
+                        onClick={() => onProject(projected ? null : { label: l.label, url: l.url })}
+                      >
+                        <Presentation />
+                      </Button>
+                    )}
+                    {CAN_EDIT_LINKS && (
+                      <>
+                        <Button
+                          size="icon-xs"
+                          variant="ghost"
+                          title={t.linksEdit}
+                          aria-label={t.linksEdit}
+                          onMouseDown={noFocus}
+                          onClick={() => setForm({ original: l })}
+                        >
+                          <Pencil />
+                        </Button>
+                        <Button
+                          size="icon-xs"
+                          variant="ghost"
+                          title={t.linksDelete}
+                          aria-label={t.linksDelete}
+                          onMouseDown={noFocus}
+                          onClick={() => remove(l)}
+                        >
+                          <X />
+                        </Button>
+                      </>
+                    )}
+                  </li>
+                );
+              })}
+            </ul>
+          </section>
+        ))}
+      </div>
+
+      <div className="mt-3 flex flex-wrap items-center gap-1.5">
+        {count > 1 && (
+          <Button
+            size="sm"
+            variant="outline"
+            onMouseDown={noFocus}
+            onClick={() => copy('all', linksToChat(all))}
+          >
+            {copied === 'all' ? <Check /> : <Copy />}
+            {copied === 'all' ? t.linksCopied : t.linksCopyAll}
+          </Button>
+        )}
+        {CAN_EDIT_LINKS && !form && (
+          <Button size="sm" variant="outline" onMouseDown={noFocus} onClick={() => setForm({ original: null })}>
+            <Plus /> {t.linksAdd}
+          </Button>
+        )}
+      </div>
+
+      {form && (
+        <LinkForm
+          key={form.original?.url ?? 'new'}
+          t={t}
+          original={form.original}
+          groupNames={groups.map((g) => g.name)}
+          onCancel={() => setForm(null)}
+          onSubmit={(next, scope) => submit(next, scope, form.original)}
+        />
+      )}
+
+      {error && <p className="mt-2 text-[11.5px] text-amber-300/90">{error}</p>}
+      <p className="mt-2 text-[11px] leading-snug text-muted-foreground">
+        {CAN_EDIT_LINKS ? t.linksHint : t.linksReadOnly}
+      </p>
+    </div>
+  );
+}
+
+function LinkForm({
+  t,
+  original,
+  groupNames,
+  onCancel,
+  onSubmit,
+}: {
+  t: ReturnType<typeof useLocale>['toolbox'];
+  original: ScopedLink | null;
+  groupNames: string[];
+  onCancel: () => void;
+  onSubmit: (link: Link, scope: LinkScope) => void;
+}) {
+  const [label, setLabel] = useState(original?.label ?? '');
+  const [url, setUrl] = useState(original?.url ?? '');
+  const [groupe, setGroupe] = useState(original?.groupe ?? '');
+  const [scope, setScope] = useState<LinkScope>(original?.scope ?? 'deck');
+  const [touched, setTouched] = useState(false);
+  const listId = useId();
+  const urlOk = isHttpUrl(url);
+  const ready = label.trim() !== '' && urlOk;
+  const go = () => {
+    setTouched(true);
+    if (!ready) return;
+    onSubmit({ label: label.trim(), url: url.trim(), ...(groupe.trim() ? { groupe: groupe.trim() } : {}) }, scope);
+  };
+  const keys = (e: React.KeyboardEvent) => {
+    if (e.key === 'Enter') {
+      e.preventDefault();
+      go();
+    } else if (e.key === 'Escape') {
+      e.preventDefault();
+      e.stopPropagation();
+      onCancel();
+    }
+  };
+  return (
+    <div className="mt-3 grid gap-1.5 rounded-[6px] border border-foreground/20 p-2.5">
+      <input
+        // biome-ignore lint/a11y/noAutofocus: the user just asked to add/edit a link
+        autoFocus
+        value={label}
+        onChange={(e) => setLabel(e.target.value)}
+        onKeyDown={keys}
+        placeholder={t.linksLabel}
+        aria-label={t.linksLabel}
+        className={field}
+      />
+      <input
+        value={url}
+        onChange={(e) => setUrl(e.target.value)}
+        onKeyDown={keys}
+        placeholder={t.linksUrl}
+        aria-label={t.linksUrl}
+        inputMode="url"
+        className={cn(field, 'font-mono', touched && !urlOk && 'border-amber-400/70')}
+      />
+      {touched && !urlOk && <p className="text-[11px] text-amber-300/90">{t.linksUrlInvalid}</p>}
+      <div className="flex gap-1.5">
+        <input
+          value={groupe}
+          onChange={(e) => setGroupe(e.target.value)}
+          onKeyDown={keys}
+          placeholder={t.linksGroup}
+          aria-label={t.linksGroup}
+          list={listId}
+          className={cn(field, 'min-w-0 flex-1')}
+        />
+        <datalist id={listId}>
+          {groupNames.map((n) => (
+            <option key={n} value={n} />
+          ))}
+        </datalist>
+        <select
+          value={scope}
+          onChange={(e) => setScope(e.target.value as LinkScope)}
+          aria-label={t.linksScope}
+          className={field}
+        >
+          <option value="deck">{t.linksScopeDeck}</option>
+          <option value="global">{t.linksScopeGlobal}</option>
+        </select>
+      </div>
+      <div className="flex gap-1.5">
+        <Button size="sm" variant="brand" onMouseDown={noFocus} onClick={go}>
+          <Check /> {t.linksSave}
+        </Button>
+        <Button size="sm" variant="ghost" onMouseDown={noFocus} onClick={onCancel}>
+          {t.linksCancel}
+        </Button>
+      </div>
+    </div>
+  );
+}
