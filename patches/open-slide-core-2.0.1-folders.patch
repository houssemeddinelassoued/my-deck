+      ref={dotRef}
+      aria-hidden
+      className="pointer-events-none fixed top-0 left-0 z-[60] motion-safe:transition-opacity motion-safe:duration-150"
+      style={{ ...LASER_DOT_STYLE, width: size, height: size, opacity: 0 }}
+    />
+  );
+}
