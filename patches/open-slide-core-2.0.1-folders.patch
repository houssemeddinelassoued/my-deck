diff --git b/src/app/routes/share-viewer.tsx b/src/app/routes/share-viewer.tsx
new file mode 100644
index 0000000..aba1288
--- /dev/null
+++ b/src/app/routes/share-viewer.tsx
@@ -0,0 +1,196 @@
+import { Play } from 'lucide-react';
+import { type ReactNode, useCallback, useMemo, useRef, useState } from 'react';
+import { useParams } from 'react-router-dom';
+import { Player } from '../components/player';
+import { SlideCanvas } from '../components/slide-canvas';
+import { SlidePageProvider } from '../lib/page-context';
+import { slideIds } from '../lib/slides';
+import { type StepController, StepHost } from '../lib/step-context';
+import { useDocumentTitle } from '../lib/use-document-title';
+import { format, useLocale } from '../lib/use-locale';
+import { useSlideModule } from '../lib/use-slide-module';
+
+// ─── Share links ──────────────────────────────────────────────────────────
+// A share link is `<base>v/<code>`: an opaque code instead of the deck id, so
+// the URL says nothing about the deck or the rest of the site. It opens a
+// play-only, fullscreen viewer — no editor, no speaker notes, no presenter
+// view, no home. The code is a salted hash of the deck id (11 chars), plus 4
+// chars for "this page only" links; it is deterministic, so a link keeps
+// working across deploys for as long as the deck keeps its id.
+//
+// This hides, it does not protect: the deployed bundle still contains every
+// deck (and its notes) for anyone who goes looking in the JavaScript.
+
+const SALT = 'open-slide/share/v1:';
+const DECK_LEN = 11;
+const PAGE_LEN = 4;
+const PAGE_SPACE = 36 ** PAGE_LEN;
+
+// cyrb53 — small, well-distributed 53-bit string hash (public domain).
+function cyrb53(str: string, seed = 0): number {
+  let h1 = 0xdeadbeef ^ seed;
+  let h2 = 0x41c6ce57 ^ seed;
+  for (let i = 0; i < str.length; i++) {
+    const ch = str.charCodeAt(i);
+    h1 = Math.imul(h1 ^ ch, 2654435761);
+    h2 = Math.imul(h2 ^ ch, 1597334677);
+  }
+  h1 = Math.imul(h1 ^ (h1 >>> 16), 2246822507) ^ Math.imul(h2 ^ (h2 >>> 13), 3266489909);
+  h2 = Math.imul(h2 ^ (h2 >>> 16), 2246822507) ^ Math.imul(h1 ^ (h1 >>> 13), 3266489909);
+  return 4294967296 * (2097151 & h2) + (h1 >>> 0);
+}
+
+const deckCode = (slideId: string) =>
+  cyrb53(SALT + slideId).toString(36).padStart(DECK_LEN, '0').slice(-DECK_LEN);
+
+const pageMask = (slideId: string) => cyrb53(`${SALT}page:${slideId}`) % PAGE_SPACE;
+
+/** Share code for a deck, or for one page of it (0-based `page`). */
+export function shareCode(slideId: string, page?: number): string {
+  const deck = deckCode(slideId);
+  if (page === undefined) return deck;
+  const code = (page + 1 + pageMask(slideId)) % PAGE_SPACE;
+  return deck + code.toString(36).padStart(PAGE_LEN, '0');
+}
+
+/** Absolute share URL for the current origin + deploy base. */
+export function shareUrl(slideId: string, page?: number): string {
+  return `${window.location.origin}${import.meta.env.BASE_URL}v/${shareCode(slideId, page)}`;
+}
+
+function resolveShareCode(code: string): { slideId: string; page: number | null } | null {
+  const lower = code.toLowerCase();
+  if (lower.length !== DECK_LEN && lower.length !== DECK_LEN + PAGE_LEN) return null;
+  const slideId = slideIds.find((id) => deckCode(id) === lower.slice(0, DECK_LEN));
+  if (!slideId) return null;
+  if (lower.length === DECK_LEN) return { slideId, page: null };
+  const value = Number.parseInt(lower.slice(DECK_LEN), 36);
+  if (!Number.isFinite(value)) return null;
+  const page = ((value - pageMask(slideId) + PAGE_SPACE) % PAGE_SPACE) - 1;
+  return page >= 0 ? { slideId, page } : null;
+}
+
+export function ShareViewer() {
+  const { code = '' } = useParams();
+  const target = useMemo(() => resolveShareCode(code), [code]);
+  if (!target) return <ShareUnavailable />;
+  return <SharedDeck slideId={target.slideId} lockedPage={target.page} />;
+}
+
+function SharedDeck({ slideId, lockedPage }: { slideId: string; lockedPage: number | null }) {
+  const t = useLocale();
+  const { slide, error } = useSlideModule(slideId);
+  useDocumentTitle(slide?.meta?.title);
+  const pages = slide?.default ?? [];
+  const [index, setIndex] = useState(0);
+  const [playing, setPlaying] = useState(false);
+  const [started, setStarted] = useState(false);
+
+  // "This page only" links keep the whole deck mounted (so in-slide page
+  // numbers stay right) but pin the index: reveals still step, pages don't.
+  const shown = lockedPage ?? index;
+  const onIndexChange = useCallback(
+    (next: number) => {
+      if (lockedPage === null) setIndex(next);
+    },
+    [lockedPage],
+  );
+  // Esc (or leaving fullscreen) drops back to the start screen: the deck is
+  // only ever shown full screen.
+  const onExit = useCallback(() => setPlaying(false), []);
+
+  if (error || (slide && (pages.length === 0 || shown >= pages.length))) {
+    return <ShareUnavailable />;
+  }
+  if (!slide) return <ShareShell>{null}</ShareShell>;
+
+  if (playing) {
+    return (
+      <Player
+        pages={pages}
+        design={slide.design}
+        transition={slide.transition}
+        index={shown}
+        onIndexChange={onIndexChange}
+        onExit={onExit}
+        fullscreen
+      />
+    );
+  }
+
+  const Poster = pages[shown];
+  return (
+    <ShareShell>
+      <div className="w-full max-w-[min(960px,92vw)]">
+        <div className="pointer-events-none aspect-video w-full overflow-hidden rounded-[8px] shadow-floating ring-1 ring-white/10">
+          <SlideCanvas flat design={slide.design}>
+            <SlidePageProvider index={shown} total={pages.length}>
+              <PosterStepHost>
+                <Poster />
+              </PosterStepHost>
+            </SlidePageProvider>
+          </SlideCanvas>
+        </div>
+      </div>
+      <div className="flex flex-col items-center gap-3 text-center">
+        <h1 className="max-w-[48rem] text-balance font-heading text-lg font-semibold tracking-tight text-white">
+          {slide.meta?.title ?? ''}
+        </h1>
+        {lockedPage !== null && (
+          <p className="text-[12px] text-white/50">
+            {format(t.share.pageOnly, { n: lockedPage + 1, total: pages.length })}
+          </p>
+        )}
+        <button
+          type="button"
+          autoFocus
+          onClick={() => {
+            setStarted(true);
+            setPlaying(true);
+          }}
+          className="mt-1 inline-flex items-center gap-2 rounded-full bg-white px-6 py-2.5 text-[15px] font-semibold text-black shadow-floating transition-transform hover:scale-[1.03] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white active:scale-[0.98]"
+        >
+          <Play className="size-4 fill-current" />
+          {started ? t.share.resume : t.share.start}
+        </button>
+        <p className="text-[11.5px] text-white/45">
+          {lockedPage === null ? t.share.hintDeck : t.share.hintPage}
+        </p>
+      </div>
+    </ShareShell>
+  );
+}
+
+function PosterStepHost({ children }: { children: ReactNode }) {
+  const noopControllerRef = useRef<StepController | null>(null);
+  return (
+    <StepHost
+      isActivePage={false}
+      entryDirection="jump"
+      controllerRef={noopControllerRef}
+      controlledRevealed={0}
+    >
+      {children}
+    </StepHost>
+  );
+}
+
+function ShareShell({ children }: { children: ReactNode }) {
+  return (
+    <div className="flex min-h-dvh w-full flex-col items-center justify-center gap-7 bg-[#0b0b0d] px-4 py-10 text-white">
+      {children}
+    </div>
+  );
+}
+
+function ShareUnavailable() {
+  const t = useLocale();
+  return (
+    <ShareShell>
+      <div className="max-w-md text-center">
+        <h1 className="font-heading text-xl font-semibold tracking-tight">{t.share.unavailableTitle}</h1>
+        <p className="mt-2 text-[13px] text-white/55">{t.share.unavailableBody}</p>
+      </div>
+    </ShareShell>
+  );
+}
