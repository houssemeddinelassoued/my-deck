+
+  if (!dayPlan) return null;
+  const span = dayPlan.span;
+
+  if (config === null || editing) {
+    return (
+      <form
+        className="flex items-center gap-1.5"
+        onSubmit={(e) => {
+          e.preventDefault();
+          validate();
+        }}
+      >
+        <span className="font-mono text-[10px] tracking-[0.06em] uppercase text-white/45">
+          {multiDay ? `Début J${day}` : 'Début'}
+        </span>
+        <input
+          type="datetime-local"
+          value={draftStart || toDateTimeInput(suggestedStart(plan, day))}
+          onChange={(e) => setDraftStart(e.target.value)}
+          className="h-7 rounded-[3px] border border-white/15 bg-white/5 px-1.5 font-mono text-[12px] text-foreground [color-scheme:dark]"
+        />
+        <span
+          className="font-mono text-[10px] tracking-[0.06em] uppercase text-white/45"
+          title={`Optionnel : le plan (${formatGap(span)}) est étiré ou resserré pour finir à cette heure`}
+        >
+          Fin
+        </span>
+        <input
+          type="time"
+          value={draftEnd}
+          onChange={(e) => setDraftEnd(e.target.value)}
+          title={`Optionnel — durée prévue par les notes : ${formatGap(span)}`}
+          className="h-7 rounded-[3px] border border-white/15 bg-white/5 px-1.5 font-mono text-[12px] text-foreground [color-scheme:dark]"
+        />
+        <span className="font-mono text-[10px] tracking-[0.06em] uppercase text-white/45">
+          Marge
+        </span>
+        <input
+          type="number"
+          min={0}
+          max={120}
+          value={draftTol}
+          onChange={(e) => setDraftTol(e.target.value)}
+          title="Écart toléré (minutes) avant de signaler une avance ou un retard"
+          className="h-7 w-12 rounded-[3px] border border-white/15 bg-white/5 px-1.5 font-mono text-[12px] text-foreground [color-scheme:dark]"
+        />
+        <button
+          type="submit"
+          className="flex h-7 items-center gap-1 rounded-[3px] border border-white/20 bg-white/10 px-2 font-mono text-[11px] text-foreground hover:bg-white/20"
+        >
+          <Check className="size-3.5" /> Valider
+        </button>
+        {hasTimers && (
+          <button
+            type="button"
+            onClick={() => validate(true)}
+            title="Enregistre ce début, puis recale les minuteurs des pages à venir sur le temps restant"
+            className="flex h-7 items-center gap-1 rounded-[3px] border border-white/20 bg-white/10 px-2 font-mono text-[11px] text-foreground hover:bg-white/20"
+          >
+            <TimerIcon className="size-3.5" /> Recaler les minuteurs
+          </button>
+        )}
+      </form>
+    );
+  }
+
+  const scale = config.end && span > 0 ? (config.end - config.start) / 60000 / span : 1;
+  const gap = pacingGap(plan, index, config.start, checkedAt, scale);
+  const expected = expectedIndex(plan, day, config.start, checkedAt, scale);
+  const slide = plan.slides[index];
+  const plannedAt = config.start + slide.start * scale * 60000;
+  const plannedEnd = config.start + span * scale * 60000;
+  const synchro = Math.abs(gap) <= config.tolerance;
+  const late = gap > 0;
+  const tone = synchro
+    ? 'border-emerald-300/30 bg-emerald-300/10 text-emerald-200'
+    : late
+      ? 'border-rose-300/30 bg-rose-300/10 text-rose-200'
+      : 'border-sky-300/30 bg-sky-300/10 text-sky-200';
+  const signed = Math.round(gap) === 0 ? '' : ` · ${late ? '+' : '−'}${formatGap(gap)}`;
+  const label = synchro
+    ? `Synchrone${signed}`
+    : late
+      ? `En retard de ${formatGap(gap)}`
+      : `En avance de ${formatGap(gap)}`;
+  const estimated = plan.slides.filter((s) => s.day === day && s.source === 'estimate').length;
+  const title = [
+    `Cette slide est prévue à ${hhmm(plannedAt)} (${formatGap(slide.minutes * scale)})`,
+    `Slide attendue maintenant : ${expected + 1}`,
+    `Début ${hhmm(config.start)} · fin prévue ${hhmm(plannedEnd)}`,
+    `Marge : ±${config.tolerance} min · recalculé à chaque changement de slide`,
+    estimated
+      ? `Durées estimées (longueur des notes, clics, minuteurs) pour ${estimated} slide(s) sans « ⏱ »`
+      : 'Durées lues dans les notes (« ⏱ N min ») et repères horaires',
+  ].join('\n');
+
+  const remainingEnd = config.end ?? config.start + span * 60000;
+  const panelRows = timers ?? [];
+
+  return (
+    <div className="relative flex items-center gap-1.5">
+      <span
+        title={title}
+        className={`rounded-[3px] border px-1.5 py-0.5 font-mono text-[12px] tabular-nums ${tone}`}
+      >
+        {label}
+      </span>
+      <span title={title} className="font-mono text-[11px] tabular-nums text-white/45">
+        prévu {hhmm(plannedAt)} · attendu p.{expected + 1}
+      </span>
+      {hasTimers && (
+        <button
+          type="button"
+          title="Minuteurs des TP : recaler sur le temps restant, ou ajuster chaque durée"
+          onClick={() => setPanelOpen((open) => !open)}
+          className={`rounded-[3px] p-1 hover:bg-white/10 hover:text-foreground ${panelOpen ? 'bg-white/10 text-foreground' : 'text-white/45'}`}
+        >
+          <TimerIcon className="size-3.5" />
+        </button>
+      )}
+      <button
+        type="button"
+        title={multiDay ? `Modifier le début du jour ${day}` : 'Modifier l’heure de début'}
+        onClick={openForm}
+        className="rounded-[3px] p-1 text-white/45 hover:bg-white/10 hover:text-foreground"
+      >
+        <Pencil className="size-3.5" />
+      </button>
+      {hasTimers && panelOpen && (
+        <div className="absolute top-full right-0 z-50 mt-2 w-[420px] rounded-[6px] border border-white/15 bg-zinc-900 p-3 font-mono text-[12px] text-foreground shadow-2xl">
+          <div className="mb-2 flex items-center justify-between">
+            <span className="text-[10px] tracking-[0.06em] uppercase text-white/45">Minuteurs des TP</span>
+            <button
+              type="button"
+              onClick={() => setPanelOpen(false)}
+              className="rounded-[3px] px-1.5 text-white/45 hover:bg-white/10 hover:text-foreground"
+              title="Fermer"
+            >
+              ×
+            </button>
+          </div>
+          <button
+            type="button"
+            onClick={() => recalibrate()}
+            disabled={!config}
+            title={`Répartit le temps restant (${hhmm(Date.now())} → ${hhmm(remainingEnd)}) entre les minuteurs des pages à venir, au prorata de leur durée`}
+            className="mb-2 flex w-full items-center justify-center gap-1.5 rounded-[3px] border border-white/20 bg-white/10 px-2 py-1.5 hover:bg-white/20 disabled:opacity-40"
+          >
+            <TimerIcon className="size-3.5" /> Recaler sur le temps restant
+          </button>
+          {recalNote && <p className="mb-2 text-[11px] text-white/60">{recalNote}</p>}
+          <ul className="max-h-[50vh] space-y-1 overflow-y-auto pr-0.5">
+            {panelRows.map((t) => {
+              const cur = effectiveMinutes(t, overrides);
+              const changed = overrides[t.id] !== undefined;
+              const passed = t.page < index;
+              return (
+                <li
+                  key={t.id}
+                  className={`flex items-center gap-2 rounded-[3px] px-1.5 py-1 ${t.page === index ? 'bg-white/10' : ''} ${passed ? 'opacity-40' : ''}`}
+                >
+                  <span className="w-12 shrink-0 tabular-nums text-white/45">p.{t.page + 1}</span>
+                  <span className="min-w-0 flex-1 truncate">{t.label}</span>
+                  <span
+                    className={`w-16 text-right tabular-nums ${changed ? 'text-amber-200' : ''}`}
+                    title={changed ? `Durée d’origine : ${t.minutes} min` : undefined}
+                  >
+                    {cur} min
+                  </span>
+                  <button
+                    type="button"
+                    onClick={() => setTimerMinutes(t, cur - 1)}
+                    disabled={cur <= 1}
+                    title="Une minute de moins"
+                    className="flex size-6 items-center justify-center rounded-[3px] border border-white/15 hover:bg-white/10 disabled:opacity-30"
+                  >
+                    <Minus className="size-3.5" />
+                  </button>
+                  <button
+                    type="button"
+                    onClick={() => setTimerMinutes(t, cur + 1)}
+                    title="Une minute de plus"
+                    className="flex size-6 items-center justify-center rounded-[3px] border border-white/15 hover:bg-white/10"
+                  >
+                    <Plus className="size-3.5" />
+                  </button>
+                </li>
+              );
+            })}
+          </ul>
+          <button
+            type="button"
+            onClick={() => {
+              writeTimerOverrides(slideId, {});
+              setOverrides({});
+              setRecalNote(null);
+            }}
+            disabled={Object.keys(overrides).length === 0}
+            className="mt-2 w-full rounded-[3px] px-2 py-1 text-[11px] text-white/55 hover:bg-white/10 disabled:opacity-30"
+          >
+            Rétablir les durées d’origine
+          </button>
+        </div>
+      )}
+    </div>
+  );
+}
