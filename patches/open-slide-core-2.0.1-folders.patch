@@ -0,0 +1,429 @@
+// Project patch — « Boîte à outils » et « Notes de session » du formateur.
+// Logique pure, stockage et synchronisation (l'interface est dans
+// components/present/toolbox.tsx).
+import { useCallback, useEffect, useRef, useState } from 'react';
+
+// ───────────────────────── Outils partagés (projection ↔ présentateur) ─────────────────────────
+
+/**
+ * Compte à rebours : au repos (endAt et leftMs nuls), en marche (endAt) ou en
+ * pause (leftMs). `totalMs` = durée totale du tour en cours (barre de progression).
+ */
+export type Countdown = {
+  durationMs: number;
+  endAt: number | null;
+  leftMs: number | null;
+  totalMs: number | null;
+};
+export type Stopwatch = { startAt: number | null; elapsedMs: number };
+export type Draw = {
+  /** Un nom par ligne. Vide = on tire un numéro entre 1 et `pool`. */
+  names: string;
+  pool: number;
+  count: number;
+  /** Noms (ou numéros) déjà tirés : exclus des tirages suivants. */
+  drawn: string[];
+  /** Résultat affiché en projection (null = rien). */
+  shown: string[] | null;
+  /** Incrémenté à chaque tirage : relance l'animation en projection. */
+  seq: number;
+};
+export type Corner = 'tl' | 'tr' | 'bl' | 'br';
+export type ToolboxState = {
+  rev: number;
+  timer: Countdown; // minuteur d'atelier — badge en projection
+  pause: Countdown; // compte à rebours de pause — plein écran en projection
+  pauseMessage: string;
+  stopwatch: Stopwatch; // jamais projeté
+  draw: Draw;
+  /** Lien affiché en grand en projection (null = rien). */
+  link: { label: string; url: string } | null;
+  corner: Corner;
+  warnBeep: boolean;
+  endBeep: boolean;
+};
+
+/** Fin de minuteur : affichée 2 min, puis effacée. */
+export const AUTO_HIDE_MS = 2 * 60_000;
+/** Passage à l'orange (et bip optionnel) 2 min avant la fin. */
+export const WARN_MS = 2 * 60_000;
+
+const idle = (min: number): Countdown => ({
+  durationMs: min * 60_000,
+  endAt: null,
+  leftMs: null,
+  totalMs: null,
+});
+
+export const DEFAULT_TOOLBOX: ToolboxState = {
+  rev: 0,
+  timer: idle(15),
+  pause: idle(10),
+  pauseMessage: '',
+  stopwatch: { startAt: null, elapsedMs: 0 },
+  draw: { names: '', pool: 12, count: 2, drawn: [], shown: null, seq: 0 },
+  link: null,
+  corner: 'tr',
+  warnBeep: false,
+  endBeep: true,
+};
+
+export function remainingMs(c: Countdown, now: number): number {
+  if (c.endAt != null) return Math.max(0, c.endAt - now);
+  if (c.leftMs != null) return c.leftMs;
+  return c.durationMs;
+}
+export const isRunning = (c: Countdown) => c.endAt != null;
+export const isPaused = (c: Countdown) => c.endAt == null && c.leftMs != null;
+export const isFinished = (c: Countdown, now: number) => c.endAt != null && c.endAt <= now;
+/** En marche, en pause ou terminé (pas au repos). */
+export const isActive = (c: Countdown) => c.endAt != null || c.leftMs != null;
+/** Terminé depuis plus de AUTO_HIDE_MS : à effacer. */
+export const isExpired = (c: Countdown, now: number) =>
+  c.endAt != null && now - c.endAt > AUTO_HIDE_MS;
+/** Visible en projection. */
+export const isShown = (c: Countdown, now: number) => isActive(c) && !isExpired(c, now);
+export const isWarning = (c: Countdown, now: number) => {
+  const left = remainingMs(c, now);
+  return isActive(c) && left > 0 && left <= WARN_MS && (c.totalMs ?? c.durationMs) > WARN_MS;
+};
+/** Part restante du tour en cours, 0…1. */
+export function fractionLeft(c: Countdown, now: number): number {
+  const total = c.totalMs ?? c.durationMs;
+  return total > 0 ? Math.min(1, Math.max(0, remainingMs(c, now) / total)) : 0;
+}
+
+export function startCountdown(c: Countdown, now: number): Countdown {
+  const left = remainingMs(c, now);
+  if (isPaused(c) && left > 0) return { ...c, endAt: now + left, leftMs: null };
+  return { ...c, endAt: now + c.durationMs, leftMs: null, totalMs: c.durationMs };
+}
+/** « Pause jusqu'à » : 1 h 30 au plus à partir de maintenant. */
+export const MAX_UNTIL_MS = 90 * 60_000;
+
+/** Démarre jusqu'à une heure précise (epoch ms), plafonnée à MAX_UNTIL_MS. */
+export function startCountdownUntil(c: Countdown, endAt: number, now: number): Countdown {
+  const total = Math.min(MAX_UNTIL_MS, Math.max(60_000, endAt - now));
+  return { ...c, endAt: now + total, leftMs: null, totalMs: total };
+}
+export function pauseCountdown(c: Countdown, now: number): Countdown {
+  return { ...c, endAt: null, leftMs: remainingMs(c, now) };
+}
+export const resetCountdown = (c: Countdown): Countdown => ({
+  ...c,
+  endAt: null,
+  leftMs: null,
+  totalMs: null,
+});
+export function setDuration(c: Countdown, durationMs: number): Countdown {
+  return { ...resetCountdown(c), durationMs: Math.max(60_000, durationMs) };
+}
+/** ±ms sur le temps restant, sans arrêter le minuteur. */
+export function adjustCountdown(c: Countdown, deltaMs: number, now: number): Countdown {
+  const total = c.totalMs != null ? Math.max(60_000, c.totalMs + deltaMs) : null;
+  if (c.endAt != null) return { ...c, endAt: Math.max(now, c.endAt + deltaMs), totalMs: total };
+  if (c.leftMs != null) return { ...c, leftMs: Math.max(0, c.leftMs + deltaMs), totalMs: total };
+  return { ...c, durationMs: Math.max(60_000, c.durationMs + deltaMs) };
+}
+
+export const elapsedMs = (s: Stopwatch, now: number) =>
+  s.startAt != null ? s.elapsedMs + (now - s.startAt) : s.elapsedMs;
+
+/** mm:ss (ou h:mm:ss). `up` = arrondi vers le bas (chronomètre), sinon vers le haut. */
+export function fmtClock(ms: number, up = false): string {
+  const total = up ? Math.floor(Math.max(0, ms) / 1000) : Math.ceil(Math.max(0, ms) / 1000);
+  const h = Math.floor(total / 3600);
+  const m = Math.floor((total % 3600) / 60);
+  const s = total % 60;
+  const p = (n: number) => String(n).padStart(2, '0');
+  return h > 0 ? `${h}:${p(m)}:${p(s)}` : `${p(m)}:${p(s)}`;
+}
+
+export const fmtTime = (ms: number) =>
+  new Date(ms).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
+
+/** Entrées candidates du tirage : noms saisis, ou numéros 1…pool. */
+export function drawCandidates(d: Draw): string[] {
+  const names = d.names
+    .split(/\r?\n/)
+    .map((n) => n.trim())
+    .filter(Boolean);
+  return names.length > 0
+    ? Array.from(new Set(names))
+    : Array.from({ length: Math.max(1, d.pool) }, (_, i) => String(i + 1));
+}
+
+export function randomInt(max: number): number {
+  const c = globalThis.crypto;
+  if (c?.getRandomValues) {
+    const buf = new Uint32Array(1);
+    const limit = Math.floor(0x100000000 / max) * max;
+    do c.getRandomValues(buf);
+    while (buf[0] >= limit);
+    return buf[0] % max;
+  }
+  return Math.floor(Math.random() * max);
+}
+
+/** Tire `count` volontaires parmi ceux qui n'ont pas encore été tirés (réinitialise le sac si épuisé). */
+export function pickVolunteers(d: Draw): Draw {
+  const all = drawCandidates(d);
+  let bag = all.filter((n) => !d.drawn.includes(n));
+  let drawn = d.drawn;
+  const want = Math.min(Math.max(1, d.count), all.length);
+  if (bag.length < want) {
+    bag = all;
+    drawn = [];
+  }
+  const picked: string[] = [];
+  const rest = [...bag];
+  while (picked.length < want && rest.length > 0) {
+    picked.push(rest.splice(randomInt(rest.length), 1)[0]);
+  }
+  return { ...d, drawn: [...drawn, ...picked], shown: picked, seq: d.seq + 1 };
+}
+
+// ───────────────────────── Hook d'état partagé ─────────────────────────
+
+const storeKey = (slideId: string) => `osd-toolbox:${slideId}`;
+const dayOf = (ms: number) => sessionDay(new Date(ms));
+
+/** Efface ce qui ne doit pas survivre : minuteurs finis depuis 2 min, état d'un autre jour. */
+export function sanitize(s: ToolboxState, now: number): ToolboxState {
+  if (s.rev > 0 && dayOf(s.rev) !== dayOf(now)) {
+    return {
+      ...s,
+      timer: resetCountdown(s.timer),
+      pause: resetCountdown(s.pause),
+      stopwatch: { startAt: null, elapsedMs: 0 },
+      draw: { ...s.draw, drawn: [], shown: null },
+      link: null,
+    };
+  }
+  return {
+    ...s,
+    timer: isExpired(s.timer, now) ? resetCountdown(s.timer) : s.timer,
+    pause: isExpired(s.pause, now) ? resetCountdown(s.pause) : s.pause,
+  };
+}
+
+function load(slideId: string): ToolboxState {
+  try {
+    const raw = JSON.parse(window.localStorage.getItem(storeKey(slideId)) ?? 'null');
+    if (raw && typeof raw === 'object') {
+      return sanitize(
+        {
+          ...DEFAULT_TOOLBOX,
+          ...raw,
+          timer: { ...DEFAULT_TOOLBOX.timer, ...raw.timer },
+          pause: { ...DEFAULT_TOOLBOX.pause, ...raw.pause },
+          stopwatch: { ...DEFAULT_TOOLBOX.stopwatch, ...raw.stopwatch },
+          draw: { ...DEFAULT_TOOLBOX.draw, ...raw.draw },
+        },
+        Date.now(),
+      );
+    }
+  } catch {}
+  return DEFAULT_TOOLBOX;
+}
+
+export type ToolboxUpdate = (fn: (s: ToolboxState) => ToolboxState) => void;
+
+/**
+ * État de la boîte à outils, partagé entre la fenêtre de projection et la vue
+ * présentateur par un BroadcastChannel dédié (indépendant du canal du
+ * présentateur) et conservé dans localStorage (par deck). Dernier écrivain
+ * gagnant (`rev`).
+ */
+export function useToolbox(slideId: string): [ToolboxState, ToolboxUpdate] {
+  const [state, setState] = useState<ToolboxState>(() =>
+    typeof window === 'undefined' ? DEFAULT_TOOLBOX : load(slideId),
+  );
+  const stateRef = useRef(state);
+  stateRef.current = state;
+  const chanRef = useRef<BroadcastChannel | null>(null);
+
+  useEffect(() => {
+    setState(load(slideId));
+    if (typeof BroadcastChannel === 'undefined') return;
+    const ch = new BroadcastChannel(`open-slide:toolbox:${slideId}`);
+    chanRef.current = ch;
+    ch.onmessage = (e: MessageEvent<ToolboxState>) => {
+      const incoming = e.data;
+      if (incoming && typeof incoming.rev === 'number' && incoming.rev > stateRef.current.rev) {
+        setState(incoming);
+      }
+    };
+    return () => {
+      ch.close();
+      if (chanRef.current === ch) chanRef.current = null;
+    };
+  }, [slideId]);
+
+  const update = useCallback<ToolboxUpdate>(
+    (fn) => {
+      const next = { ...fn(stateRef.current), rev: Math.max(Date.now(), stateRef.current.rev + 1) };
+      stateRef.current = next;
+      setState(next);
+      try {
+        window.localStorage.setItem(storeKey(slideId), JSON.stringify(next));
+      } catch {}
+      try {
+        chanRef.current?.postMessage(next);
+      } catch {}
+    },
+    [slideId],
+  );
+
+  return [state, update];
+}
+
+/** Horloge à pas fixe, active seulement si `active` (évite de re-rendre au repos). */
+export function useNow(active: boolean, stepMs = 250): number {
+  const [now, setNow] = useState(() => Date.now());
+  useEffect(() => {
+    if (!active) return;
+    setNow(Date.now());
+    const id = window.setInterval(() => setNow(Date.now()), stepMs);
+    return () => window.clearInterval(id);
+  }, [active, stepMs]);
+  return now;
+}
+
+// ───────────────────────── Notes de session (présentateur uniquement) ─────────────────────────
+
+export type NoteKind = 'note' | 'question' | 'review' | 'idea';
+export const NOTE_KINDS: NoteKind[] = ['note', 'question', 'review', 'idea'];
+export type SessionNote = { id: string; page: number; text: string; at: number; kind?: NoteKind };
+
+export const sessionDay = (d = new Date()) =>
+  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
+
+const notesKey = (slideId: string, day: string) => `osd-notes:${slideId}:${day}`;
+
+/** Même fenêtre : l'événement `storage` n'atteint que les autres fenêtres. */
+export const SESSION_NOTES_EVENT = 'osd-session-notes';
+
+export function loadSessionNotes(slideId: string, day: string): SessionNote[] {
+  try {
+    const raw = JSON.parse(window.localStorage.getItem(notesKey(slideId, day)) ?? '[]');
+    return Array.isArray(raw) ? raw : [];
+  } catch {
+    return [];
+  }
+}
+export function saveSessionNotes(slideId: string, day: string, notes: SessionNote[]) {
+  try {
+    if (notes.length === 0) window.localStorage.removeItem(notesKey(slideId, day));
+    else window.localStorage.setItem(notesKey(slideId, day), JSON.stringify(notes));
+  } catch {}
+  window.dispatchEvent(new Event(SESSION_NOTES_EVENT));
+}
+/** Dates de session déjà enregistrées pour ce deck (plus récente d'abord). */
+export function listSessionDays(slideId: string): string[] {
+  const out: string[] = [];
+  try {
+    const prefix = `osd-notes:${slideId}:`;
+    for (let i = 0; i < window.localStorage.length; i++) {
+      const k = window.localStorage.key(i);
+      if (k?.startsWith(prefix)) out.push(k.slice(prefix.length));
+    }
+  } catch {}
+  return out.sort().reverse();
+}
+
+/** Pages qui ont des notes aujourd'hui (pastilles de l'aperçu, touche O). */
+export function useSessionNoteMarks(slideId: string | undefined, enabled: boolean): Set<number> {
+  const [marks, setMarks] = useState<Set<number>>(() => new Set());
+  useEffect(() => {
+    if (!enabled || !slideId) return;
+    const read = () => setMarks(new Set(loadSessionNotes(slideId, sessionDay()).map((n) => n.page)));
+    read();
+    window.addEventListener('storage', read);
+    window.addEventListener(SESSION_NOTES_EVENT, read);
+    return () => {
+      window.removeEventListener('storage', read);
+      window.removeEventListener(SESSION_NOTES_EVENT, read);
+    };
+  }, [slideId, enabled]);
+  return marks;
+}
+
+/**
+ * Titre lisible d'une slide, tiré de l'en-tête de ses speaker notes
+ * (« ⏱ 2 min · ACCUEIL (…) » → « ACCUEIL »). Vide si rien d'exploitable.
+ */
+export function slideTitleFromNote(note: string | undefined): string {
+  if (!note) return '';
+  const first = note.trim().split('\n')[0]?.trim() ?? '';
+  let line = first;
+  if (line.startsWith('⏱')) {
+    const parts = line.split(' · ');
+    line = parts.slice(1).join(' · ');
+  } else if (line.includes(' — ') || line.length > 70) {
+    return '';
+  }
+  line = line
+    .replace(/\([^)]*\)/g, '')
+    .replace(/\s*·\s*\d{1,2}\s*[h:]\s*\d{0,2}.*$/, '')
+    .replace(/\s+/g, ' ')
+    .trim();
+  return line.length > 70 ? `${line.slice(0, 67)}…` : line;
+}
+
+export type NotesMarkdownLabels = {
+  title: string; // « Notes de session — {title} »
+  date: string; // « Date : {day} »
+  slide: string; // « Slide {n} »
+  none: string;
+  kinds: Record<NoteKind, string>;
+};
+
+/** Export Markdown : une section par catégorie, puis par slide (avec son titre). */
+export function notesToMarkdown(
+  labels: NotesMarkdownLabels,
+  deckTitle: string,
+  day: string,
+  notes: SessionNote[],
+  slideTitles: (page: number) => string,
+): string {
+  const fill = (s: string, v: Record<string, string | number>) =>
+    s.replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ''));
+  const lines = [`# ${fill(labels.title, { title: deckTitle })}`, '', fill(labels.date, { day }), ''];
+  if (notes.length === 0) return [...lines, labels.none, ''].join('\n');
+  for (const kind of NOTE_KINDS) {
+    const ofKind = notes
+      .filter((n) => (n.kind ?? 'note') === kind)
+      .sort((a, b) => a.page - b.page || a.at - b.at);
+    if (ofKind.length === 0) continue;
+    lines.push(`## ${labels.kinds[kind]}`, '');
+    let page = -1;
+    for (const n of ofKind) {
+      if (n.page !== page) {
+        page = n.page;
+        const title = slideTitles(page);
+        lines.push(`### ${fill(labels.slide, { n: page + 1 })}${title ? ` — ${title}` : ''}`, '');
+      }
+      const [head, ...more] = n.text.trim().split('\n');
+      lines.push(`- ${fmtTime(n.at)} — ${head}`, ...more.map((l) => `  ${l}`));
+    }
+    lines.push('');
+  }
+  return lines.join('\n');
+}
+
+/** Chemin du fichier écrit par le serveur de dev (relatif au projet). */
+export const sessionFilePath = (slideId: string, day: string) => `docs/sessions/${slideId}/${day}.md`;
+
+/** Écrit l'export Markdown dans docs/sessions/<deck>/<jour>.md (serveur de dev uniquement). */
+export async function writeSessionFile(slideId: string, day: string, markdown: string): Promise<void> {
+  const res = await fetch('/__session-notes', {
+    method: 'PUT',
+    headers: { 'content-type': 'application/json' },
+    body: JSON.stringify({ slideId, day, markdown }),
+  });
+  if (!res.ok) {
+    const body = (await res.json().catch(() => ({}))) as { error?: string };
+    throw new Error(body.error ?? `PUT /__session-notes → ${res.status}`);
+  }
+}
