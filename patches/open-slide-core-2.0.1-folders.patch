diff --git b/src/app/components/folder-lock.tsx b/src/app/components/folder-lock.tsx
new file mode 100644
index 0000000..40c13c0
--- /dev/null
+++ b/src/app/components/folder-lock.tsx
@@ -0,0 +1,248 @@
+import { Eye, EyeOff, Lock } from 'lucide-react';
+import { type ReactNode, useEffect, useRef, useState } from 'react';
+import { Link, useParams } from 'react-router-dom';
+import { Button } from '@/components/ui/button';
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from '@/components/ui/dialog';
+import {
+  DEFAULT_FOLDER_PASSWORD,
+  isFolderLocked,
+  unlockFolder,
+  useUnlockedFolders,
+} from '@/lib/folder-lock';
+import { useFolders } from '@/lib/folders';
+import type { Folder } from '@/lib/sdk';
+import { format, useLocale } from '@/lib/use-locale';
+import { cn } from '@/lib/utils';
+import { FolderIconChip } from './sidebar/folder-item';
+
+function PasswordInput({
+  value,
+  onChange,
+  onEnter,
+  invalid,
+  autoFocus,
+}: {
+  value: string;
+  onChange: (value: string) => void;
+  onEnter: () => void;
+  invalid?: boolean;
+  autoFocus?: boolean;
+}) {
+  const [visible, setVisible] = useState(false);
+  const inputRef = useRef<HTMLInputElement | null>(null);
+  const t = useLocale();
+
+  useEffect(() => {
+    if (!autoFocus) return;
+    queueMicrotask(() => {
+      inputRef.current?.focus();
+      inputRef.current?.select();
+    });
+  }, [autoFocus]);
+
+  return (
+    <div className="relative w-full">
+      <input
+        ref={inputRef}
+        type={visible ? 'text' : 'password'}
+        value={value}
+        onChange={(e) => onChange(e.target.value)}
+        onKeyDown={(e) => {
+          if (e.nativeEvent.isComposing) return;
+          if (e.key === 'Enter') {
+            e.preventDefault();
+            onEnter();
+          }
+        }}
+        aria-invalid={invalid || undefined}
+        autoComplete="off"
+        maxLength={64}
+        placeholder={t.folderLock.passwordPlaceholder}
+        className={cn(
+          'h-9 w-full rounded-[6px] border border-border bg-background pl-3 pr-9 font-mono text-[13px] tracking-[0.08em] outline-none',
+          'focus-visible:border-foreground/40 focus-visible:ring-2 focus-visible:ring-ring/30',
+          'aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/25',
+        )}
+      />
+      <button
+        type="button"
+        onClick={() => setVisible((v) => !v)}
+        aria-label={visible ? t.folderLock.hidePassword : t.folderLock.showPassword}
+        className="absolute right-1.5 top-1/2 flex size-6 -translate-y-1/2 items-center justify-center rounded-[4px] text-muted-foreground outline-none hover:bg-muted hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring/30"
+      >
+        {visible ? <EyeOff className="size-3.5" /> : <Eye className="size-3.5" />}
+      </button>
+    </div>
+  );
+}
+
+/** Password prompt shown in place of a locked folder's content. */
+export function UnlockPanel({
+  folder,
+  hint,
+  onUnlocked,
+}: {
+  folder: Folder;
+  hint: string;
+  onUnlocked?: () => void;
+}) {
+  const [value, setValue] = useState('');
+  const [wrong, setWrong] = useState(false);
+  const t = useLocale();
+
+  const submit = () => {
+    if (unlockFolder(folder, value)) {
+      setValue('');
+      setWrong(false);
+      onUnlocked?.();
+    } else {
+      setWrong(true);
+    }
+  };
+
+  return (
+    <div className="rounded-[8px] border border-dashed border-border px-8 py-16">
+      <div className="mx-auto flex max-w-[320px] flex-col items-center text-center">
+        <span className="relative flex size-10 items-center justify-center rounded-full bg-muted">
+          <Lock className="size-4.5 text-foreground/80" aria-hidden />
+          <FolderIconChip
+            icon={folder.icon}
+            className="absolute -right-1 -bottom-1 ring-2 ring-background"
+          />
+        </span>
+        <p className="mt-4 font-heading text-[14px] font-semibold tracking-tight">
+          {format(t.folderLock.lockedTitle, { name: folder.name })}
+        </p>
+        <p className="mt-1.5 text-[13px] leading-relaxed text-muted-foreground">{hint}</p>
+        <div className="mt-5 flex w-full flex-col gap-2">
+          <PasswordInput
+            value={value}
+            onChange={(v) => {
+              setValue(v);
+              setWrong(false);
+            }}
+            onEnter={submit}
+            invalid={wrong}
+            autoFocus
+          />
+          <p
+            className={cn(
+              'h-4 text-left text-[11.5px] text-destructive',
+              !wrong && 'invisible',
+            )}
+            aria-live="polite"
+          >
+            {t.folderLock.wrongPassword}
+          </p>
+          <Button size="sm" onClick={submit} disabled={!value}>
+            {t.folderLock.unlock}
+          </Button>
+        </div>
+      </div>
+    </div>
+  );
+}
+
+export function FolderPasswordDialog({
+  open,
+  folder,
+  onOpenChange,
+  onSubmit,
+}: {
+  open: boolean;
+  folder: Folder | null;
+  onOpenChange: (open: boolean) => void;
+  onSubmit: (password: string) => Promise<void> | void;
+}) {
+  const isChange = Boolean(folder?.lock);
+  const [value, setValue] = useState(DEFAULT_FOLDER_PASSWORD);
+  const [submitting, setSubmitting] = useState(false);
+  const t = useLocale();
+
+  useEffect(() => {
+    if (open) {
+      setValue(isChange ? '' : DEFAULT_FOLDER_PASSWORD);
+      setSubmitting(false);
+    }
+  }, [open, isChange]);
+
+  const submit = async () => {
+    if (!value) return;
+    setSubmitting(true);
+    try {
+      await onSubmit(value);
+    } finally {
+      setSubmitting(false);
+    }
+  };
+
+  const name = folder?.name ?? '';
+  return (
+    <Dialog open={open} onOpenChange={onOpenChange}>
+      <DialogContent>
+        <DialogHeader>
+          <span className="eyebrow">{t.folderLock.dialogEyebrow}</span>
+          <DialogTitle>
+            {format(isChange ? t.folderLock.dialogChangeTitle : t.folderLock.dialogTitle, {
+              name,
+            })}
+          </DialogTitle>
+          <DialogDescription>{t.folderLock.dialogDescription}</DialogDescription>
+        </DialogHeader>
+        <div className="flex flex-col gap-2">
+          <PasswordInput value={value} onChange={setValue} onEnter={submit} autoFocus={open} />
+          <p className="text-[11.5px] text-muted-foreground">
+            {format(t.folderLock.dialogDefaultHint, { password: DEFAULT_FOLDER_PASSWORD })}
+            {' · '}
+            {t.folderLock.dialogClientSideNote}
+          </p>
+        </div>
+        <DialogFooter>
+          <Button variant="ghost" size="sm" onClick={() => onOpenChange(false)}>
+            {t.common.cancel}
+          </Button>
+          <Button size="sm" disabled={submitting || !value} onClick={submit}>
+            <Lock />
+            {t.common.save}
+          </Button>
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+}
+
+/**
+ * Guards /s/:slideId routes: a deck inside a locked folder can't be opened by
+ * URL until its folder is unlocked in this tab.
+ */
+export function SlideLockGate({ children }: { children: ReactNode }) {
+  const { slideId } = useParams<{ slideId: string }>();
+  const { manifest, loading } = useFolders();
+  const state = useUnlockedFolders();
+  const t = useLocale();
+
+  if (loading) return null;
+  const folderId = slideId ? manifest.assignments[slideId] : undefined;
+  const folder = folderId ? manifest.folders.find((f) => f.id === folderId) : undefined;
+  if (!folder || !isFolderLocked(folder, state)) return <>{children}</>;
+
+  return (
+    <div className="grid min-h-dvh place-items-center bg-background px-5 text-foreground">
+      <div className="w-full max-w-[460px]">
+        <UnlockPanel folder={folder} hint={t.folderLock.lockedSlideHint} />
+        <div className="mt-4 text-center">
+          <Link to="/" className="text-[12.5px] text-muted-foreground hover:text-foreground">
+            {t.common.home}
+          </Link>
+        </div>
+      </div>
+    </div>
+  );
+}
