+// User-arrangeable presenter panes. The first visible pane in `order` fills
+// the main column; the others stack in the side column. `main` is the main
+// column's share of the row width (lg+ only — narrower windows stack every
+// pane); `side` is the top side pane's share of the side column's height, or
+// null for its natural size (up-next keeps the slide's aspect ratio, anything
+// else takes half).
+type PaneId = 'now' | 'next' | 'notes';
+type PresenterLayout = {
+  order: PaneId[];
+  hidden: PaneId[];
+  mainRight: boolean;
+  main: number;
+  side: number | null;
+};
+
+const PANE_IDS: PaneId[] = ['now', 'next', 'notes'];
+const PRESENTER_LAYOUT_STORAGE_KEY = 'open-slide:presenter-layout';
+const DEFAULT_PRESENTER_LAYOUT: PresenterLayout = {
+  order: PANE_IDS,
+  hidden: [],
+  mainRight: false,
+  main: 200 / 3,
+  side: null,
+};
+const MIN_MAIN_PCT = 20;
+const MAX_MAIN_PCT = 85;
+const MIN_SIDE_PCT = 0;
+const MAX_SIDE_PCT = 85;
+
+const clamp = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));
+
+function readPresenterLayout(): PresenterLayout {
+  if (typeof window === 'undefined') return DEFAULT_PRESENTER_LAYOUT;
+  try {
+    const raw = JSON.parse(window.localStorage.getItem(PRESENTER_LAYOUT_STORAGE_KEY) ?? 'null');
+    if (!raw || typeof raw !== 'object') return DEFAULT_PRESENTER_LAYOUT;
+    const isPermutation =
+      Array.isArray(raw.order) &&
+      raw.order.length === PANE_IDS.length &&
+      PANE_IDS.every((id) => raw.order.includes(id));
+    // `next` is the pre-arrangement name of `side`.
+    const side = raw.side ?? raw.next;
+    return {
+      order: isPermutation ? raw.order : PANE_IDS,
+      hidden: Array.isArray(raw.hidden) ? PANE_IDS.filter((id) => raw.hidden.includes(id)) : [],
+      mainRight: raw.mainRight === true,
