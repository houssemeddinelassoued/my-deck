+/** The slide canvas as fitted (letterboxed) inside `el`, in client pixels. */
+export function fittedSlideRect(el: HTMLElement) {
+  const r = el.getBoundingClientRect();
+  const s = Math.min(r.width / CANVAS_WIDTH, r.height / CANVAS_HEIGHT);
+  if (!(s > 0)) return null;
+  const width = CANVAS_WIDTH * s;
+  const height = CANVAS_HEIGHT * s;
