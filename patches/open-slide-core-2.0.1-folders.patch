+// User-arrangeable presenter panes. The first visible pane in `order` fills
+// the main column; the others stack in the side column. `main` is the main
+// column's share of the row width (lg+ only — narrower windows stack every
+// pane); `side` is the top side pane's share of the side column's height, or
+// null for its natural size (up-next keeps the slide's aspect ratio, anything
+// else takes half).
+type PaneId = 'now' | 'next' | 'notes';
+type PresenterLayout = {
+  order: PaneId[];
+  hidden: PaneId[];
+  mainRight: boolean;
+  main: number;
+  side: number | null;
+};
+
+const PANE_IDS: PaneId[] = ['now', 'next', 'notes'];
+const PRESENTER_LAYOUT_STORAGE_KEY = 'open-slide:presenter-layout';
+const DEFAULT_PRESENTER_LAYOUT: PresenterLayout = {
+  order: PANE_IDS,
+  hidden: [],
+  mainRight: false,
+  main: 200 / 3,
+  side: null,
+};
+const MIN_MAIN_PCT = 20;
+const MAX_MAIN_PCT = 85;
+const MIN_SIDE_PCT = 0;
+const MAX_SIDE_PCT = 85;
+
+const clamp = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));
+
+function readPresenterLayout(): PresenterLayout {
+  if (typeof window === 'undefined') return DEFAULT_PRESENTER_LAYOUT;
+  try {
+    const raw = JSON.parse(window.localStorage.getItem(PRESENTER_LAYOUT_STORAGE_KEY) ?? 'null');
+    if (!raw || typeof raw !== 'object') return DEFAULT_PRESENTER_LAYOUT;
+    const isPermutation =
+      Array.isArray(raw.order) &&
+      raw.order.length === PANE_IDS.length &&
+      PANE_IDS.every((id) => raw.order.includes(id));
+    // `next` is the pre-arrangement name of `side`.
+    const side = raw.side ?? raw.next;
+    return {
+      order: isPermutation ? raw.order : PANE_IDS,
+      hidden: Array.isArray(raw.hidden) ? PANE_IDS.filter((id) => raw.hidden.includes(id)) : [],
+      mainRight: raw.mainRight === true,
+      main: Number.isFinite(raw.main)
+        ? clamp(raw.main, MIN_MAIN_PCT, MAX_MAIN_PCT)
+        : DEFAULT_PRESENTER_LAYOUT.main,
+      side: Number.isFinite(side) ? clamp(side, MIN_SIDE_PCT, MAX_SIDE_PCT) : null,
+    };
+  } catch {
+    return DEFAULT_PRESENTER_LAYOUT;
+  }
+}
+
+type SetPresenterLayout = (update: (layout: PresenterLayout) => PresenterLayout) => void;
+
+function usePresenterLayout(): [PresenterLayout, SetPresenterLayout] {
+  const [layout, setLayout] = useState(readPresenterLayout);
+  useEffect(() => {
+    try {
+      window.localStorage.setItem(PRESENTER_LAYOUT_STORAGE_KEY, JSON.stringify(layout));
+    } catch {}
+  }, [layout]);
+  return [layout, setLayout];
+}
+
+const swapPanes = (order: PaneId[], a: PaneId, b: PaneId) =>
+  order.map((id) => (id === a ? b : id === b ? a : id));
+
+function usePaneTitles(): Record<PaneId, string> {
+  const t = useLocale();
+  return { now: t.presenter.nowShowing, next: t.presenter.upNext, notes: t.presenter.speakerNotes };
+}
+
+function PresenterPanels({
+  layout,
+  setLayout,
+  nowSurfaceRef,
+  laser,
+  nowContent,
+  nextTitle,
+  nextContent,
+  note,
+}: {
+  layout: PresenterLayout;
+  setLayout: SetPresenterLayout;
+  nowSurfaceRef: RefObject<HTMLDivElement | null>;
+  laser: boolean;
+  nowContent: ReactNode;
+  nextTitle: string;
+  nextContent: ReactNode;
+  note: string | undefined;
+}) {
+  const t = useLocale();
+  const titles = usePaneTitles();
+  const [notesSize, setNotesSize] = useNotesFontSize();
+  const [dragging, setDragging] = useState<PaneId | null>(null);
+  const [dropTarget, setDropTarget] = useState<PaneId | null>(null);
+  const rowRef = useRef<HTMLDivElement | null>(null);
+  const mainRef = useRef<HTMLElement | null>(null);
+  const sideRef = useRef<HTMLDivElement | null>(null);
+  const sideTopRef = useRef<HTMLElement | null>(null);
+  const dragStartRef = useRef(0);
+
+  const visible = layout.order.filter((id) => !layout.hidden.includes(id));
+  const [mainId, ...sideIds] = visible;
+  const twoSide = sideIds.length === 2;
+  // Natural sizing only makes sense for the up-next preview.
+  const sideTopAuto = twoSide && layout.side === null && sideIds[0] === 'next';
+
+  const sizeOf = (el: HTMLElement | null, axis: 'width' | 'height') =>
+    el?.getBoundingClientRect()[axis] ?? 0;
+  const setMain = (pct: number) =>
+    setLayout((l) => ({ ...l, main: clamp(pct, MIN_MAIN_PCT, MAX_MAIN_PCT) }));
+  const setSide = (pct: number) =>
+    setLayout((l) => ({ ...l, side: clamp(pct, MIN_SIDE_PCT, MAX_SIDE_PCT) }));
