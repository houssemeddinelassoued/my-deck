+
+const kindVars = (kind: CueKind): CSSProperties =>
+  ({ '--osn-k': `var(--osn-${kind})`, '--osn-kbg': `var(--osn-${kind}-bg)` }) as CSSProperties;
+
+// « speech » | → / → beat N / → 1–3 | click verbs
+const CUE_INLINE =
+  /(«[^«»\n]*»)|(→(?:\s+(?:beat\s+\d+|\d+(?:\s*[–-]\s*\d+)?))?)|((?<!\p{L})(?:cliqu\p{L}*|clics?|beats?|flèches?|révél\p{L}*|révèl\p{L}*|retournez|montrer l'animation|montrez|pointez|pointer|avancez|lancez|cochez|faites défiler)(?!\p{L}))/giu;
+
+// Notes say "beat" (one press = one step); the presenter reads "Clic":
+// `→ beat 3` → `→ Clic 3`, loose "beats 1 à 6" → "clics 1 à 6".
+const clicChip = (text: string) => text.replace(/beat/i, 'Clic');
+const clicWord = (word: string) =>
+  word.replace(/^(b)eat/i, (_, b: string) => (b === 'B' ? 'Clic' : 'clic'));
+
+// A short quote with no sentence punctuation inside a click/interaction
+// section is a button or option label (« Valider ma sélection »), not speech.
+const isUiLabel = (quote: string, kind: CueKind) =>
+  (kind === 'click' || kind === 'interact') &&
+  !/[.?!…:;]/.test(quote) &&
+  quote.slice(1, -1).trim().split(/\s+/).length <= 3;
+
+function decorateText(text: string, kind: CueKind, step: number | null): ReactNode[] {
+  const out: ReactNode[] = [];
+  let last = 0;
+  let k = 0;
+  for (const m of text.matchAll(CUE_INLINE)) {
+    if (m.index > last) out.push(text.slice(last, m.index));
+    if (m[1]) {
+      out.push(
+        <span key={k++} className={isUiLabel(m[1], kind) ? 'osn-ui' : 'osn-say'}>
+          {m[1]}
+        </span>,
+      );
+    } else if (m[2]) {
+      const state = stepState(cueRange(m[2]), step);
+      out.push(
+        <span key={k++} className="osn-arrow" data-state={state}>
+          {state === 'done' ? '✓ ' : ''}
+          {clicChip(m[2])}
+        </span>,
+      );
+      if (state === 'now' || state === 'next') {
+        out.push(
+          <span key={k++} className="osn-here" data-state={state}>
+            {state === 'now' ? '● À L’ÉCRAN' : 'PROCHAIN CLIC'}
+          </span>,
+        );
+      }
+    } else {
+      out.push(
+        <span key={k++} className="osn-verb">
+          {clicWord(m[3])}
+        </span>,
+      );
+    }
+    last = m.index + m[0].length;
+  }
+  if (last < text.length) out.push(text.slice(last));
+  return out;
+}
+
+function renderCueInline(nodes: NoteInline[], kind: CueKind, step: number | null): ReactNode {
+  return nodes.map((node, i) => {
+    switch (node.type) {
+      case 'text':
+        // biome-ignore lint/suspicious/noArrayIndexKey: static parse output, never reordered
+        return <Fragment key={i}>{decorateText(node.text, kind, step)}</Fragment>;
+      case 'strong':
+        return (
+          // biome-ignore lint/suspicious/noArrayIndexKey: static parse output, never reordered
+          <strong key={i} className="font-semibold">
+            {renderCueInline(node.children, kind, step)}
+          </strong>
+        );
+      case 'em':
+        return (
+          // biome-ignore lint/suspicious/noArrayIndexKey: static parse output, never reordered
+          <em key={i}>{renderCueInline(node.children, kind, step)}</em>
+        );
+      case 'code':
+        return (
+          // biome-ignore lint/suspicious/noArrayIndexKey: static parse output, never reordered
+          <code key={i} className={CODE_CLASS}>
+            {node.text}
+          </code>
+        );
+      default:
+        return node satisfies never;
+    }
+  });
+}
+
+type CueSection = { kind: CueKind | 'time' | 'plain'; label?: string; blocks: NoteBlock[] };
+
+function firstText(block: NoteBlock): string | null {
+  if (block.type !== 'paragraph') return null;
+  const head = block.lines[0]?.[0];
+  return head?.type === 'text' ? head.text : null;
+}
+
+function cueSections(blocks: NoteBlock[]): CueSection[] | null {
+  const sections: CueSection[] = [];
+  let labelled = false;
+  for (const block of blocks) {
+    const head = firstText(block);
+    const m = head !== null ? CUE_LABEL.exec(head) : null;
+    if (m && head !== null && block.type === 'paragraph') {
+      labelled = true;
+      const trimmed: NoteInline[] = [
+        { type: 'text', text: head.slice(m[0].length) },
+        ...block.lines[0].slice(1),
+      ];
+      sections.push({
+        kind: cueKind(m[1]),
+        label: m[1],
+        blocks: [{ ...block, lines: [trimmed, ...block.lines.slice(1)] }],
+      });
+    } else if (sections.length === 0 && head?.trimStart().startsWith('⏱')) {
+      sections.push({ kind: 'time', blocks: [block] });
+    } else {
+      const cur = sections[sections.length - 1];
+      if (cur && cur.kind !== 'time') cur.blocks.push(block);
+      else sections.push({ kind: 'plain', blocks: [block] });
+    }
+  }
+  return labelled ? sections : null;
+}
+
+function renderCueBlock(
+  block: NoteBlock,
+  kind: CueKind,
+  key: number,
+  step: number | null,
+  pill?: ReactNode,
+): ReactNode {
+  switch (block.type) {
+    case 'heading': {
+      const Tag = `h${block.level + 3}` as 'h4' | 'h5' | 'h6';
+      return (
+        <Tag key={key} className={`font-semibold ${HEADING_SIZES[block.level]}`}>
+          {renderCueInline(block.children, kind, step)}
+        </Tag>
+      );
+    }
+    case 'list': {
+      const Tag = block.ordered ? 'ol' : 'ul';
+      return (
+        <Tag
+          key={key}
+          className={`space-y-[0.2em] pl-[1.4em] ${block.ordered ? 'list-decimal' : 'list-disc'}`}
+        >
+          {block.items.map((item, i) => (
+            // biome-ignore lint/suspicious/noArrayIndexKey: static parse output, never reordered
+            <li key={i}>{renderCueInline(item, kind, step)}</li>
+          ))}
+        </Tag>
+      );
+    }
+    case 'paragraph': {
+      // Lines opening with a click cue become their own highlightable row;
+      // the first line stays inline when it follows the section pill.
+      const ranges = block.lines.map(lineRange);
+      return (
+        <p key={key}>
+          {pill}
+          {block.lines.map((line, i) => {
+            const range = ranges[i];
+            const row = range !== null && !(i === 0 && pill);
+            const prevRow = i > 0 && ranges[i - 1] !== null && !(i === 1 && pill);
+            const body = renderCueInline(line, kind, step);
+            return (
+              // biome-ignore lint/suspicious/noArrayIndexKey: static parse output, never reordered
+              <Fragment key={i}>
+                {i > 0 && !row && !prevRow && <br />}
+                {row ? (
+                  <span className="osn-step" data-state={stepState(range, step)}>
+                    {body}
+                  </span>
+                ) : (
+                  body
+                )}
+              </Fragment>
+            );
+          })}
+        </p>
+      );
+    }
+    default:
+      return block satisfies never;
+  }
+}
+
+function CueNotes({
+  sections,
+  step,
+  clicks,
+}: {
+  sections: CueSection[];
+  step: number | null;
+  clicks: number;
+}) {
+  const used = new Set(sections.map((s) => s.kind));
+  const rootRef = useRef<HTMLDivElement | null>(null);
+  // Keep the current (or next) click cue in view as the presenter advances.
+  // biome-ignore lint/correctness/useExhaustiveDependencies: re-run on step / note change
+  useEffect(() => {
+    const root = rootRef.current;
+    if (!root || step === null) return;
+    const target =
+      root.querySelector('.osn-step[data-state=now], .osn-arrow[data-state=now]') ??
+      root.querySelector('.osn-step[data-state=next], .osn-arrow[data-state=next]');
+    target?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
+  }, [step, sections]);
+  return (
+    <div ref={rootRef} className="osn-cues space-y-[0.55em] whitespace-pre-wrap">
+      <style>{CUE_CSS}</style>
+      <div className="osn-legend" aria-hidden="true">
+        {(Object.keys(CUE_META) as CueKind[])
+          .filter((kind) => kind === 'read' || kind === 'click' || used.has(kind))
+          .map((kind) => (
+            <span key={kind} style={kindVars(kind)}>
+              <i />
+              {CUE_META[kind].icon} {CUE_META[kind].legend}
+            </span>
+          ))}
+        {step !== null && clicks > 0 && (
+          <span className="osn-progress">
+            {step === 0
+              ? `Avant le clic 1 / ${clicks}`
+              : `🖱 Clic ${Math.min(step, clicks)} / ${clicks}`}
+          </span>
+        )}
+      </div>
+      {sections.map((section, si) => {
+        if (section.kind === 'time') {
+          return (
+            // biome-ignore lint/suspicious/noArrayIndexKey: static parse output, never reordered
+            <div key={si} className="osn-time">
+              {section.blocks.map((b, bi) => renderCueBlock(b, 'info', bi, step))}
+            </div>
+          );
+        }
+        const kind: CueKind = section.kind === 'plain' ? 'info' : section.kind;
+        const pill =
+          section.label !== undefined ? (
+            <span className="osn-pill">
+              {CUE_META[kind].icon} {section.label}
+            </span>
+          ) : undefined;
+        return (
+          // biome-ignore lint/suspicious/noArrayIndexKey: static parse output, never reordered
+          <div key={si} className="osn-sec" data-kind={kind} style={kindVars(kind)}>
+            {section.blocks.map((b, bi) =>
+              renderCueBlock(b, kind, bi, step, bi === 0 ? pill : undefined),
+            )}
+          </div>
+        );
+      })}
+    </div>
+  );
+}
+
+// `step` = reveals already shown on the projection, `stepCount` = reveals on
+// the page (presenter view only); when given, click cues show their state
+// (done / on screen / next) and a « Clic n / N » counter tops the notes.
+export function NoteMarkdown({
+  text,
+  step,
+  stepCount,
+}: {
+  text: string;
+  step?: number;
+  stepCount?: number;
+}) {
   const blocks = useMemo(() => parseNoteMarkdown(text), [text]);
+  const sections = useMemo(() => cueSections(blocks), [blocks]);
+  const cues = useMemo(() => maxCue(text), [text]);
+  // The slide's real reveal count wins; the notes' highest cue is a fallback.
+  const clicks = stepCount || cues;
+  if (sections) return <CueNotes sections={sections} step={step ?? null} clicks={clicks} />;
   return <div className="space-y-[0.65em] whitespace-pre-wrap">{blocks.map(renderBlock)}</div>;
 }
