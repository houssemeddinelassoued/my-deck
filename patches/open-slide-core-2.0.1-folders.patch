+}
+
+// ═════════════════════════ Vue présentateur ═════════════════════════
+
+export function PresenterToolbox({
+  slideId,
+  slideTitle,
+  index,
+  speakerNotes,
+  timers,
+  onJump,
+  bottom = 76,
+}: {
+  slideId: string;
+  slideTitle: string;
+  index: number;
+  speakerNotes?: readonly (string | undefined)[];
+  timers?: readonly DeckTimer[];
+  onJump: (index: number) => void;
+  bottom?: number;
+}) {
+  const t = useLocale().toolbox;
+  const [state, update] = useToolbox(slideId);
+  const [open, setOpen] = useState(false);
+  const [tab, setTab] = useState<Tab>('timer');
+  const [showKeys, setShowKeys] = useState(false);
+
+  const ticking = isActive(state.timer) || isActive(state.pause) || state.stopwatch.startAt != null;
+  const now = useNow(ticking || open);
+
+  // T = boîte à outils, N = notes de session, Échap = fermer.
+  useEffect(() => {
+    const onKey = (e: KeyboardEvent) => {
+      if (isTypingTarget(e.target) || hasModifier(e)) return;
+      if (e.key === 't' || e.key === 'T') {
+        e.preventDefault();
+        setOpen((v) => !v);
+      } else if (e.key === 'n' || e.key === 'N') {
+        e.preventDefault();
+        setTab('notes');
+        setOpen(true);
+      } else if (e.key === 'Escape' && open) {
+        e.stopImmediatePropagation();
+        setOpen(false);
+      }
+    };
+    window.addEventListener('keydown', onKey, true);
+    return () => window.removeEventListener('keydown', onKey, true);
+  }, [open]);
+
+  // Fin + 2 min : on efface (la projection masque déjà d'elle-même).
+  useEffect(() => {
+    if (isExpired(state.timer, now) || isExpired(state.pause, now)) {
+      update((s) => ({
+        ...s,
+        timer: isExpired(s.timer, Date.now()) ? resetCountdown(s.timer) : s.timer,
+        pause: isExpired(s.pause, Date.now()) ? resetCountdown(s.pause) : s.pause,
+      }));
+    }
+  }, [now, state.timer, state.pause, update]);
+
+  // Bips : 2 min avant la fin (option) et à la fin.
+  const prevLeft = useRef<{ timer: number; pause: number } | null>(null);
+  useEffect(() => {
+    const left = {
+      timer: isRunning(state.timer) ? remainingMs(state.timer, now) : Number.POSITIVE_INFINITY,
+      pause: isRunning(state.pause) ? remainingMs(state.pause, now) : Number.POSITIVE_INFINITY,
+    };
+    const prev = prevLeft.current;
+    prevLeft.current = left;
+    if (!prev) return;
+    for (const k of ['timer', 'pause'] as const) {
+      if (state.endBeep && prev[k] > 0 && left[k] === 0) beep(3);
+      else if (state.warnBeep && prev[k] > WARN_MS && left[k] <= WARN_MS && left[k] > 0) beep(1);
+    }
+  }, [now, state.timer, state.pause, state.endBeep, state.warnBeep]);
+
+  // Durée du TP de la slide : préremplie quand on arrive sur la slide (minuteur au repos).
+  const slideTimer = useMemo(() => {
+    const found = timers?.find((x) => x.page === index);
+    return found ? { label: found.label, minutes: effectiveMinutes(found, readTimerOverrides(slideId)) } : null;
+  }, [timers, index, slideId]);
+  const stateRef = useRef(state);
+  stateRef.current = state;
+  useEffect(() => {
