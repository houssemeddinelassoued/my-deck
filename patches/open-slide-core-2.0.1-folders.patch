+  const running = s.startAt != null;
+  return (
+    <div>
+      <FieldLabel first>{t.chronoLabel}</FieldLabel>
+      <BigClock value={fmtClock(elapsedMs(s, now), true)} tone={running ? 'ok' : 'idle'} />
+      <div className="mt-2.5 flex justify-center gap-1.5">
+        {running ? (
+          <Button
+            size="sm"
+            variant="outline"
+            onMouseDown={noFocus}
+            onClick={() => onChange((x) => ({ startAt: null, elapsedMs: elapsedMs(x, Date.now()) }))}
+          >
+            <Pause /> {t.pause}
+          </Button>
+        ) : (
+          <Button size="sm" variant="brand" onMouseDown={noFocus} onClick={() => onChange((x) => ({ ...x, startAt: Date.now() }))}>
+            <Play /> {s.elapsedMs > 0 ? t.resume : t.start}
+          </Button>
+        )}
+        <Button
+          size="sm"
+          variant="outline"
+          disabled={!running && s.elapsedMs === 0}
+          onMouseDown={noFocus}
+          onClick={() => onChange(() => ({ startAt: null, elapsedMs: 0 }))}
+        >
+          <RotateCcw /> {t.resetChrono}
+        </Button>
+      </div>
+    </div>
+  );
+}
+
+function DrawTool({ t, d, onChange }: { t: Strings; d: Draw; onChange: (fn: (d: Draw) => Draw) => void }) {
