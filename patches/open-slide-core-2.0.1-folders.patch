+
+/**
+ * Laser dot mirrored between the projection and presenter windows. Positions
+ * travel as fractions of the slide canvas, so each window maps them onto its
+ * own (differently sized, letterboxed) render of the slide. Whichever window
+ * moved last owns the dot.
+ *
+ * `surfaceRef` is the box the slide is fitted into. With `scope: 'window'`
+ * the local pointer drives the dot anywhere in the window (projection); with
+ * `scope: 'surface'` only while it is over that box (presenter preview).
+ */
+export function SyncedLaserPointer({
+  enabled,
+  surfaceRef,
+  scope,
+  size = 18,
+  remoteRef,
+  onLocalMove,
+}: {
+  enabled: boolean;
+  surfaceRef: RefObject<HTMLElement | null>;
+  scope: 'window' | 'surface';
+  size?: number;
+  remoteRef: RefObject<LaserRemote | null>;
+  onLocalMove: (point: LaserPoint) => void;
