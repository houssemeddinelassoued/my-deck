+ * the slide are reported, so a replayed click is never echoed back. Listens
+ * in the capture phase: slide content that stops propagation still counts.
+ */
+export function useSlideClickMirror({
+  enabled,
+  surfaceRef,
+  onLocalClick,
+}: {
+  enabled: boolean;
+  surfaceRef: RefObject<HTMLElement | null>;
+  onLocalClick: (point: SlidePoint) => void;
+}) {
+  const onLocalClickRef = useRef(onLocalClick);
+  onLocalClickRef.current = onLocalClick;
