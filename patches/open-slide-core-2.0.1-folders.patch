+// Countdown timers of a deck (the « Minuteurs » of the presenter view).
+//
+// A deck lists its timers in `export const timers` (generated by
+// scripts/timers-manifest.mjs): page (0-based), id, label, default minutes.
+// The presenter re-times them without touching the deck: the chosen minutes
+// are stored per deck in localStorage (`osd-timers:<slideId>`), and the
+// Timer component of the deck reads them (and follows them live, in every
+// window of the same browser).
+import type { PacingPlan } from './pacing';
+
+export type DeckTimer = {
+  id: string;
+  label: string;
+  /** Page index, 0-based. */
+  page: number;
+  /** Default duration, minutes. */
+  minutes: number;
+};
+
+export type TimerOverrides = Record<string, number>;
+
+/** Same-window notification (the storage event only reaches the other windows). */
+export const TIMER_OVERRIDES_EVENT = 'osd-timers';
+
+const storageKey = (slideId: string) => `osd-timers:${slideId}`;
+
+export function readTimerOverrides(slideId: string): TimerOverrides {
+  try {
+    const raw = JSON.parse(window.localStorage.getItem(storageKey(slideId)) ?? 'null');
+    if (!raw || typeof raw !== 'object') return {};
+    const out: TimerOverrides = {};
+    for (const [id, value] of Object.entries(raw)) {
+      if (typeof value === 'number' && Number.isFinite(value) && value > 0) out[id] = value;
+    }
+    return out;
+  } catch {
+    return {};
+  }
+}
+
+export function writeTimerOverrides(slideId: string, next: TimerOverrides): void {
+  try {
+    if (Object.keys(next).length === 0) window.localStorage.removeItem(storageKey(slideId));
+    else window.localStorage.setItem(storageKey(slideId), JSON.stringify(next));
+  } catch {}
+  window.dispatchEvent(new Event(TIMER_OVERRIDES_EVENT));
+}
+
+export const effectiveMinutes = (timer: DeckTimer, overrides: TimerOverrides) =>
+  overrides[timer.id] ?? timer.minutes;
+
+export type Recalibration = {
+  overrides: TimerOverrides;
+  /** Real time left until the end, minutes. */
+  available: number;
+  /** Planned minutes of the rest of the day that are not timers. */
+  fixed: number;
+  /** Factor applied to the default durations of the remaining timers. */
+  factor: number;
+  /** Number of timers re-timed. */
+  count: number;
+};
+
+/**
+ * Re-times the timers of the rest of the training day so that they fill the
+ * real time left (`endAt` − `now`) once the planned content of the other pages
+ * is taken out. Timers on pages already passed keep their value. Each timer
+ * keeps its proportion to the others, never goes under one minute, and whole
+ * minutes are used.
+ */
+export function recalibrateTimers(args: {
+  timers: readonly DeckTimer[];
+  plan: PacingPlan;
+  /** Index of the page on screen. */
+  index: number;
+  /** Real end of the training day (epoch ms). */
+  endAt: number;
+  now: number;
+  overrides: TimerOverrides;
+}): Recalibration {
+  const { timers, plan, index, endAt, now } = args;
+  const day = plan.slides[index]?.day ?? 1;
+  const pageDay = (page: number) => plan.slides[page]?.day === day;
+
+  // Planned time left in the day: from the planned start of the page on screen
+  // to the planned end of the day (breaks included, as the plan has them).
+  const dayPlan = plan.days.find((d) => d.day === day);
+  const plannedRest = dayPlan ? Math.max(0, dayPlan.span - (plan.slides[index]?.start ?? 0)) : 0;
+  const remaining = timers.filter((t) => t.page >= index && pageDay(t.page));
+  const timerMinutes = remaining.reduce((sum, t) => sum + t.minutes, 0);
+  // The planned time of a timer page includes its timer; keep only the rest.
+  const fixed = Math.max(0, plannedRest - timerMinutes);
+  const available = (endAt - now) / 60000;
+  const budget = available - fixed;
+  const factor = timerMinutes > 0 ? Math.max(0, budget) / timerMinutes : 1;
+
+  const overrides = { ...args.overrides };
+  for (const t of remaining) overrides[t.id] = Math.max(1, Math.round(t.minutes * factor));
+  return { overrides, available, fixed, factor, count: remaining.length };
+}
