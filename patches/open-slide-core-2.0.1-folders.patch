new file mode 100644
index 0000000..cda84bd
--- /dev/null
+++ b/src/app/lib/folder-lock.ts
@@ -0,0 +1,168 @@
+import config from 'virtual:open-slide/config';
+import { useMemo, useSyncExternalStore } from 'react';
+import type { Folder, FoldersManifest } from './sdk';
+
+/**
+ * Folder password protection.
+ *
+ * A protected folder stores only `sha256("open-slide:<folderId>:<password>")`
+ * in slides/.folders.json. Unlocking is remembered per browser tab
+ * (sessionStorage) and is tied to the hash, so changing the password re-locks
+ * every tab. This is a client-side gate: it keeps casual viewers out of the
+ * browser UI, but the deck code still ships in the static bundle.
+ */
+// Overridable from open-slide.config.ts → `folderLock.defaultPassword`.
+export const DEFAULT_FOLDER_PASSWORD = config.folderLock?.defaultPassword || '0999';
+
+const STORAGE_KEY = 'open-slide:unlocked-folders';
+
+// biome-ignore format: SHA-256 round constants
+const K = new Uint32Array([
+  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
+  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
+  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
+]);
+
+const rotr = (x: number, n: number) => (x >>> n) | (x << (32 - n));
+
+// Synchronous SHA-256: crypto.subtle is missing on non-secure origins (e.g.
+// the dev server opened over a LAN IP), and a sync hash keeps callers simple.
+function sha256Hex(message: string): string {
+  const bytes = new TextEncoder().encode(message);
+  const size = ((bytes.length + 9 + 63) >> 6) << 6;
+  const buf = new Uint8Array(size);
+  buf.set(bytes);
+  buf[bytes.length] = 0x80;
+  const view = new DataView(buf.buffer);
+  const bitLen = bytes.length * 8;
+  view.setUint32(size - 8, Math.floor(bitLen / 0x100000000));
+  view.setUint32(size - 4, bitLen >>> 0);
+
+  const h = new Uint32Array([
+    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
+  ]);
+  const w = new Uint32Array(64);
+  for (let off = 0; off < size; off += 64) {
+    for (let i = 0; i < 16; i++) w[i] = view.getUint32(off + i * 4);
+    for (let i = 16; i < 64; i++) {
+      const x = w[i - 15];
+      const y = w[i - 2];
+      const s0 = rotr(x, 7) ^ rotr(x, 18) ^ (x >>> 3);
+      const s1 = rotr(y, 17) ^ rotr(y, 19) ^ (y >>> 10);
+      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) >>> 0;
+    }
+    let [a, b, c, d, e, f, g, hh] = h;
+    for (let i = 0; i < 64; i++) {
+      const t1 =
+        (hh + (rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)) + ((e & f) ^ (~e & g)) + K[i] + w[i]) >>> 0;
+      const t2 = ((rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)) + ((a & b) ^ (a & c) ^ (b & c))) >>> 0;
+      hh = g;
+      g = f;
+      f = e;
+      e = (d + t1) >>> 0;
+      d = c;
+      c = b;
+      b = a;
+      a = (t1 + t2) >>> 0;
+    }
+    h[0] += a;
+    h[1] += b;
+    h[2] += c;
+    h[3] += d;
+    h[4] += e;
+    h[5] += f;
+    h[6] += g;
+    h[7] += hh;
+  }
+  return Array.from(h, (x) => x.toString(16).padStart(8, '0')).join('');
+}
+
+export function hashFolderPassword(folderId: string, password: string): string {
+  return sha256Hex(`open-slide:${folderId}:${password}`);
+}
+
+// ─── Unlock store (per tab) ───────────────────────────────────────────────
+
+type Unlocked = Record<string, string>;
+
+function readUnlocked(): Unlocked {
+  try {
+    const raw = window.sessionStorage.getItem(STORAGE_KEY);
+    const parsed = raw ? JSON.parse(raw) : {};
+    return parsed && typeof parsed === 'object' ? (parsed as Unlocked) : {};
+  } catch {
+    return {};
+  }
+}
+
+let unlocked: Unlocked = typeof window === 'undefined' ? {} : readUnlocked();
+const listeners = new Set<() => void>();
+
+function writeUnlocked(next: Unlocked) {
+  unlocked = next;
+  try {
+    window.sessionStorage.setItem(STORAGE_KEY, JSON.stringify(next));
+  } catch {}
+  for (const l of listeners) l();
+}
+
+function subscribe(listener: () => void) {
+  listeners.add(listener);
+  return () => listeners.delete(listener);
+}
+
+export function useUnlockedFolders(): Unlocked {
+  return useSyncExternalStore(
+    subscribe,
+    () => unlocked,
+    () => unlocked,
+  );
+}
+
+export function isFolderLocked(folder: Folder | undefined, state: Unlocked = unlocked): boolean {
+  return Boolean(folder?.lock) && state[folder!.id] !== folder!.lock!.hash;
+}
+
+/** Returns false when the password is wrong. */
+export function unlockFolder(folder: Folder, password: string): boolean {
+  if (!folder.lock) return true;
+  if (hashFolderPassword(folder.id, password) !== folder.lock.hash) return false;
+  writeUnlocked({ ...unlocked, [folder.id]: folder.lock.hash });
+  return true;
+}
+
+/** Mark a folder unlocked with a hash we just set (so its owner isn't locked out). */
+export function rememberUnlocked(folderId: string, hash: string) {
+  writeUnlocked({ ...unlocked, [folderId]: hash });
+}
+
+export function relockFolder(folderId: string) {
+  if (!(folderId in unlocked)) return;
+  const { [folderId]: _, ...rest } = unlocked;
+  writeUnlocked(rest);
+}
+
+export type FolderLocks = {
+  isLocked: (folderId: string) => boolean;
+  /** Slides whose folder is currently locked: hidden from every listing. */
+  hiddenSlides: Set<string>;
+};
+
+export function useFolderLocks(manifest: FoldersManifest): FolderLocks {
+  const state = useUnlockedFolders();
+  return useMemo(() => {
+    const locked = new Set(
+      manifest.folders.filter((f) => isFolderLocked(f, state)).map((f) => f.id),
+    );
+    const hiddenSlides = new Set<string>();
+    for (const [slideId, folderId] of Object.entries(manifest.assignments)) {
+      if (locked.has(folderId)) hiddenSlides.add(slideId);
+    }
+    return { isLocked: (id) => locked.has(id), hiddenSlides };
+  }, [manifest, state]);
+}
