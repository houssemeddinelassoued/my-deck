+      const surface = surfaceRef.current;
+      if (!e.isTrusted || e.button !== 0 || !surface) return;
+      const target = e.target;
+      if (!(target instanceof Node) || !surface.contains(target)) return;
+      if (target instanceof Element && target.closest('[data-osd-chrome]')) return;
+      const r = fittedSlideRect(surface);
+      if (!r) return;
+      const x = (e.clientX - r.left) / r.width;
+      const y = (e.clientY - r.top) / r.height;
+      if (x < 0 || x > 1 || y < 0 || y > 1) return;
+      onLocalClickRef.current({ x, y });
+    };
+    window.addEventListener('click', onClick, true);
+    return () => window.removeEventListener('click', onClick, true);
+  }, [enabled, surfaceRef]);
+}
+
+/**
+ * Replays a mirrored click on whatever sits at `point` of the slide fitted in
+ * `surface`: the full pointer → mouse → click sequence, so slide widgets and
+ * the projection's click-to-navigate edges react exactly as to a real click.
+ */
+export function replaySlideClick(surface: HTMLElement | null, point: SlidePoint) {
+  if (!surface) return;
+  const r = fittedSlideRect(surface);
+  if (!r) return;
+  const clientX = r.left + point.x * r.width;
+  const clientY = r.top + point.y * r.height;
+  // Skip present chrome (control bar, progress strip) layered over the slide.
+  const target = document
+    .elementsFromPoint(clientX, clientY)
+    .find((el) => !el.closest('[data-osd-chrome]'));
