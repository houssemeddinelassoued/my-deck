+import { Check, Minus, Pencil, Plus, Timer as TimerIcon } from 'lucide-react';
+import { useEffect, useMemo, useState } from 'react';
+import {
+  type DeckTimer,
+  effectiveMinutes,
+  readTimerOverrides,
+  recalibrateTimers,
+  TIMER_OVERRIDES_EVENT,
+  type TimerOverrides,
+  writeTimerOverrides,
+} from '../../lib/deck-timers';
+import { buildPacingPlan, expectedIndex, type PacingPlan, pacingGap } from '../../lib/pacing';
+
+// Punctuality badge of the presenter view. The trainer types the real start
+// of the current training day (and optionally its end); on every slide change
+// the badge compares "now" with the time the plan (lib/pacing.ts) expects
+// that slide to be shown, and says early / on time / late. A gap within the
+// margin (15 min by default) counts as on time.
+const DEFAULT_TOLERANCE_MIN = 15;
+
+type DayConfig = { start: number; end: number | null; tolerance: number };
+
+const storageKey = (slideId: string, day: number) => `osd-pace:${slideId}:${day}`;
+
+function readConfig(slideId: string, day: number): DayConfig | null {
+  try {
+    const raw = JSON.parse(window.localStorage.getItem(storageKey(slideId, day)) ?? 'null');
+    if (raw && Number.isFinite(raw.start) && raw.start > 0) {
+      return {
+        start: raw.start,
+        end: Number.isFinite(raw.end) && raw.end > raw.start ? raw.end : null,
+        tolerance: Number.isFinite(raw.tolerance) ? raw.tolerance : DEFAULT_TOLERANCE_MIN,
+      };
+    }
+  } catch {}
+  return null;
+}
+
+const pad = (n: number) => String(n).padStart(2, '0');
+
+function toDateTimeInput(ms: number): string {
+  const d = new Date(ms);
+  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
+}
+
+function toTimeInput(ms: number): string {
+  const d = new Date(ms);
+  return `${pad(d.getHours())}:${pad(d.getMinutes())}`;
+}
+
+const hhmm = (ms: number) => toTimeInput(ms).replace(':', ' h ');
+
+function formatGap(minutes: number): string {
+  const m = Math.round(Math.abs(minutes));
+  const h = Math.floor(m / 60);
+  const min = m % 60;
+  if (h && min) return `${h} h ${pad(min)}`;
+  if (h) return `${h} h`;
+  return `${min} min`;
+}
+
+/** Default start offered in the form: today at the plan's own start time, else now. */
+function suggestedStart(plan: PacingPlan, day: number): number {
+  const clock = plan.days.find((d) => d.day === day)?.clockStart;
+  if (clock === null || clock === undefined) return Date.now();
+  const d = new Date();
+  d.setHours(Math.floor(clock / 60), Math.round(clock % 60), 0, 0);
+  return d.getTime();
+}
+
+export function StartPunctuality({
+  slideId,
+  index,
+  pages,
+  notes,
+  timers,
+}: {
+  slideId: string;
+  index: number;
+  pages: readonly unknown[];
+  notes: readonly (string | undefined)[] | undefined;
+  /** The deck's countdown timers (« Minuteurs »), see lib/deck-timers.ts. */
+  timers?: readonly DeckTimer[];
+}) {
+  const plan = useMemo(() => buildPacingPlan(pages, notes), [pages, notes]);
+  const day = plan.slides[index]?.day ?? 1;
+  const dayPlan = plan.days.find((d) => d.day === day);
+  const multiDay = plan.days.length > 1;
+  const hasTimers = (timers?.length ?? 0) > 0;
+
+  const [config, setConfig] = useState<DayConfig | null>(() => readConfig(slideId, day));
+  const [editing, setEditing] = useState(false);
+  const [draftStart, setDraftStart] = useState('');
+  const [draftEnd, setDraftEnd] = useState('');
+  const [draftTol, setDraftTol] = useState(String(DEFAULT_TOLERANCE_MIN));
+  // The comparison instant: refreshed on validation and on every slide change.
+  const [checkedAt, setCheckedAt] = useState(() => Date.now());
