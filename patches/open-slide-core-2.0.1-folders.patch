+/** A laser position as fractions of the slide canvas (0–1); null = off the slide. */
+export type LaserPoint = { x: number; y: number } | null;
+export type LaserRemote = { show: (point: LaserPoint) => void };
+
+const LASER_DOT_STYLE: CSSProperties = {
+  willChange: 'transform',
+  borderRadius: '50%',
+  background: 'radial-gradient(circle, oklch(0.66 0.24 28 / 0.95) 30%, transparent 70%)',
+  boxShadow: '0 0 18px 4px oklch(0.66 0.24 28 / 0.55)',
