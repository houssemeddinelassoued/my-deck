+  const [panelOpen, setPanelOpen] = useState(false);
+  const [recalNote, setRecalNote] = useState<string | null>(null);
+
+  useEffect(() => {
+    setConfig(readConfig(slideId, day));
+    setEditing(false);
+    setOverrides(readTimerOverrides(slideId));
