diff --git b/src/app/lib/links.ts b/src/app/lib/links.ts
new file mode 100644
index 0000000..2ebf74d
--- /dev/null
+++ b/src/app/lib/links.ts
@@ -0,0 +1,100 @@
+// Project patch — « Liens utiles » du formateur : une liste globale
+// (slides/.liens.json) et une liste par deck (slides/<id>/liens.json), lues par
+// le module virtuel `virtual:open-slide/links` et modifiées (serveur de dev) par
+// la route `PUT /__links`.
+import linksData from 'virtual:open-slide/links';
+import { useCallback, useEffect, useMemo, useRef, useState } from 'react';
+
+export type Link = { label: string; url: string; groupe?: string };
+export type LinkScope = 'deck' | 'global';
+export type ScopedLink = Link & { scope: LinkScope };
+export type LinkGroup = { name: string; links: ScopedLink[] };
+
+export const DEFAULT_GROUP = 'Liens';
+/** Les liens ne s'enregistrent que si le serveur de dev tourne. */
+export const CAN_EDIT_LINKS = import.meta.env.DEV;
+
+export const isHttpUrl = (url: string) => /^https?:\/\/[^\s]+$/i.test(url.trim());
+
+export function hostOf(url: string): string {
+  try {
+    return new URL(url).host.replace(/^www\./, '');
+  } catch {
+    return url;
+  }
+}
+
+/** Texte à coller dans le Chat : « Libellé : url », une ligne par lien. */
+export const linksToChat = (links: readonly Link[]) =>
+  links.map((l) => `${l.label} : ${l.url}`).join('\n');
+
+type Lists = { global: Link[]; deck: Link[] };
+
+/** Deck d'abord, puis global (sans doublon d'URL), regroupés dans l'ordre d'apparition. */
+export function groupLinks(lists: Lists): LinkGroup[] {
+  const seen = new Set<string>();
+  const groups = new Map<string, ScopedLink[]>();
+  const push = (scope: LinkScope, list: Link[]) => {
+    for (const l of list) {
+      if (seen.has(l.url)) continue;
+      seen.add(l.url);
+      const name = l.groupe?.trim() || DEFAULT_GROUP;
+      groups.set(name, [...(groups.get(name) ?? []), { ...l, scope }]);
+    }
+  };
+  push('deck', lists.deck);
+  push('global', lists.global);
+  return Array.from(groups, ([name, links]) => ({ name, links }));
+}
+
+export function useLinks(slideId: string) {
+  const [global, setGlobal] = useState<Link[]>(linksData.global);
+  const [decks, setDecks] = useState<Record<string, Link[]>>(linksData.decks);
+  const chanRef = useRef<BroadcastChannel | null>(null);
+
+  useEffect(() => {
+    if (typeof BroadcastChannel === 'undefined') return;
+    const ch = new BroadcastChannel('open-slide:links');
+    chanRef.current = ch;
+    ch.onmessage = (e: MessageEvent<{ global: Link[]; decks: Record<string, Link[]> }>) => {
+      setGlobal(e.data.global);
+      setDecks(e.data.decks);
+    };
+    return () => {
+      ch.close();
+      chanRef.current = null;
+    };
+  }, []);
+
+  const deck = decks[slideId] ?? [];
+  const groups = useMemo(() => groupLinks({ global, deck }), [global, deck]);
+  const count = groups.reduce((n, g) => n + g.links.length, 0);
+
+  /** Remplace la liste d'une portée ; rejette si l'écriture échoue. */
+  const save = useCallback(
+    async (scope: LinkScope, links: Link[]) => {
+      const res = await fetch('/__links', {
+        method: 'PUT',
+        headers: { 'content-type': 'application/json' },
+        body: JSON.stringify({ scope, slideId, links }),
+      });
+      const body = (await res.json().catch(() => ({}))) as { error?: string; links?: Link[] };
+      if (!res.ok) throw new Error(body.error ?? `PUT /__links → ${res.status}`);
+      const saved = body.links ?? links;
+      const nextGlobal = scope === 'global' ? saved : global;
+      const nextDecks = { ...decks };
+      if (scope === 'deck') {
+        if (saved.length > 0) nextDecks[slideId] = saved;
+        else delete nextDecks[slideId];
+      }
+      setGlobal(nextGlobal);
+      setDecks(nextDecks);
+      try {
+        chanRef.current?.postMessage({ global: nextGlobal, decks: nextDecks });
+      } catch {}
+    },
+    [slideId, global, decks],
+  );
+
+  return { global, deck, groups, count, save };
+}
