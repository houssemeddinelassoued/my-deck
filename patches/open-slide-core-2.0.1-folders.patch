+  useEffect(() => {
+    if (!enabled) return;
+    let frame = 0;
+    let dot: { x: number; y: number } | null = null;
+    let outgoing: LaserPoint | undefined;
+    let lastSent: LaserPoint | undefined;
+
+    const slideRect = () => {
+      const el = surfaceRef.current;
+      if (!el) return null;
+      const r = el.getBoundingClientRect();
+      const s = Math.min(r.width / CANVAS_WIDTH, r.height / CANVAS_HEIGHT);
+      if (!(s > 0)) return null;
+      const width = CANVAS_WIDTH * s;
+      const height = CANVAS_HEIGHT * s;
+      return {
+        left: r.left + (r.width - width) / 2,
+        top: r.top + (r.height - height) / 2,
+        width,
+        height,
+      };
+    };
+
+    // Position is written straight to the element inside rAF — routing it
+    // through React state would re-render at pointer rate and lag the hand.
