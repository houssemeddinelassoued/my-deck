+  if (!mainId) {
+    return (
+      <div className="mx-6 mb-4 grid min-h-0 flex-1 place-items-center rounded-[8px] border border-dashed border-border">
+        <div className="flex flex-col items-center gap-3 text-[12px] text-muted-foreground">
+          {t.presenter.allPanesHidden}
+          <Button
+            variant="outline"
+            size="sm"
+            onClick={() => setLayout((l) => ({ ...l, hidden: [] }))}
+          >
+            <Eye className="size-3.5" /> {t.presenter.showAllPanes}
+          </Button>
+        </div>
+      </div>
