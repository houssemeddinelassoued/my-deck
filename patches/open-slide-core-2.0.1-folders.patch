+}
+
+/** Pendant ~1,5 s après un tirage, fait défiler des noms au hasard (null = pas d'animation). */
+function useRollingDraw(draw: Draw): string[] | null {
+  const [rolling, setRolling] = useState<string[] | null>(null);
+  const seenSeq = useRef(draw.seq);
+  useEffect(() => {
+    if (draw.seq === seenSeq.current) return;
+    seenSeq.current = draw.seq;
+    if (!draw.shown) return;
+    const pool = drawCandidates(draw);
+    const n = draw.shown.length;
+    if (pool.length <= n) return;
+    const roll = () => setRolling(Array.from({ length: n }, () => pool[randomInt(pool.length)]));
+    roll();
+    const id = window.setInterval(roll, 80);
+    const stop = window.setTimeout(() => {
+      window.clearInterval(id);
+      setRolling(null);
+    }, 1500);
+    return () => {
+      window.clearInterval(id);
+      window.clearTimeout(stop);
+      setRolling(null);
+    };
+  }, [draw]);
+  return rolling;
+}
+
