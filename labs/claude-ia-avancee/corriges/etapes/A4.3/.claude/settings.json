{
  "permissions": {
    "allow": [
      "Bash(node guichet.mjs *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(git commit *)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Read(./**/secrets/**)",
      "Edit(./donnees/**)",
      "Bash(git push *)",
      "Bash(curl *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/bloquer-secrets.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node guichet.mjs garde --rapide"
          }
        ]
      }
    ]
  }
}
