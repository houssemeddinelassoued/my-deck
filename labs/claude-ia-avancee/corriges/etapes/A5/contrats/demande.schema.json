{
  "$comment": "Contrat de la demande qualifiée. Source de vérité des champs : le modèle, le code et les tests l'utilisent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "priorite",
    "client",
    "contact",
    "email",
    "telephone",
    "utilisateurs_touches",
    "panne_totale",
    "resume"
  ],
  "properties": {
    "type": {
      "enum": [
        "incident",
        "evolution",
        "devis",
        "question"
      ]
    },
    "priorite": {
      "enum": [
        "P1",
        "P2",
        "P3"
      ],
      "description": "Avis du modèle ; la priorité retenue est calculée par le code (A3.4)"
    },
    "client": {
      "type": "string",
      "minLength": 1,
      "description": "Nom de l'entreprise cliente"
    },
    "contact": {
      "type": [
        "string",
        "null"
      ],
      "description": "Nom de la personne qui écrit"
    },
    "email": {
      "type": [
        "string",
        "null"
      ]
    },
    "telephone": {
      "type": [
        "string",
        "null"
      ],
      "description": "Format E.164 (+216…, +33…)"
    },
    "utilisateurs_touches": {
      "type": [
        "integer",
        "null"
      ]
    },
    "panne_totale": {
      "type": "boolean",
      "description": "Le service est-il totalement indisponible ?"
    },
    "resume": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280,
      "description": "Une phrase factuelle, sans donnée personnelle"
    },
    "site_web": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200,
      "x-source": "formulaire",
      "description": "Site web du client, recopié du formulaire (facultatif)"
    },
    "langue": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "fr",
        "en",
        null
      ],
      "x-source": "code",
      "description": "Langue du message, détectée par le code (A5)"
    },
    "equipe": {
      "type": [
        "string",
        "null"
      ],
      "x-source": "code",
      "description": "Équipe de traitement : Europe (anglais) ou Tunis (A5)"
    }
  }
}
