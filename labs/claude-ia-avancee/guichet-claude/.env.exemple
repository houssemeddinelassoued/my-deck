# Copiez ce fichier en .env si vous voulez changer les réglages par défaut.
# Le fichier .env n'est jamais commité ni lu par Claude Code (permissions et hook).

# Moteur : simu (défaut, simulateur local), claude-cli (vrai modèle via votre licence), api (clé API)
MOTEUR=simu

# Avec MOTEUR=api seulement :
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# Modèle utilisé par l'application (API et simulateur)
GUICHET_MODELE=claude-sonnet-5-5

# Ports
PORT=3000
SIMU_PORT=8787

# Stockage : sqlite (défaut) ou notion (option)
STOCKAGE=sqlite
# NOTION_TOKEN=
# NOTION_BASE=
